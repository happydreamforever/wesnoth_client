struct invalid_utf8_exception : std::runtime_error {
    invalid_utf8_exception() : std::runtime_error("invalid") {}
};
int count_leading_ones(unsigned char c) {
    int count = 0;
    while(c & 128) { ++count; c <<= 1; }
    return count;
}
namespace utf8 {
std::string& erase(std::string&, std::size_t, std::size_t = std::string::npos);
// @UNICODE@
}
namespace font {
const std::string unicode_bullet = "\xE2\x80\xA2";
struct pango_text {
    std::string value;
    bool fail_clear = false;
    const std::string& text() const { return value; }
    std::size_t get_length() const { return utf8::size(value); }
    void set_text(const std::string& text, bool) {
        if(text.empty() && fail_clear) throw std::runtime_error("dummy renderer failure");
        value = text;
    }
};
pango_text& get_text_renderer() { static pango_text renderer; return renderer; }
}
namespace lg {
enum class severity { LG_NONE = -1, LG_ERROR, LG_WARN, LG_INFO, LG_DEBUG };
std::map<std::string, severity> levels{{"gui/layout", severity::LG_DEBUG},
                                       {"gui/draw", severity::LG_WARN}, {"font", severity::LG_INFO}};
std::string fail_get, fail_set, fail_restore;
bool get_log_domain_severity(const std::string& name, severity& value) {
    if(name == fail_get || !levels.count(name)) return false;
    value = levels.at(name);
    return true;
}
bool set_log_domain_severity(const std::string& name, severity value) {
    if(name == fail_set || !levels.count(name)) return false;
    if(name == fail_restore && value != severity::LG_NONE) throw std::runtime_error("dummy restore failure");
    levels.at(name) = value;
    return true;
}
bool quiet() { return levels.at("gui/layout") == severity::LG_NONE && levels.at("gui/draw") == severity::LG_NONE; }
bool restored() { return levels.at("gui/layout") == severity::LG_DEBUG && levels.at("gui/draw") == severity::LG_WARN; }
}
namespace desktop::clipboard {
std::string value = "existing dummy clipboard";
std::string copy_from_clipboard() { return value; }
}
struct NoLog { template<class T> NoLog& operator<<(const T&) { return *this; } };
NoLog no_log;
#define DBG_GUI_E no_log
#define LOG_SCOPE_HEADER ""
using SDL_Keymod = int;
namespace gui2 {
namespace event { constexpr int NOTIFY_MODIFIED = 0; }
namespace implementation { struct builder_styled_widget {}; }
class text_box_base {
public:
    font::pango_text text_;
    std::size_t selection_start_ = 0;
    int selection_length_ = 0;
    bool editable_ = true, ime_composing_ = false;
    unsigned modified_events = 0;
    virtual ~text_box_base() = default;
    virtual void set_value(const std::string&);
    const std::string& get_value() const { return text_.text(); }
    bool get_use_markup() const { return false; }
    void set_use_markup(bool) {}
    bool is_editable() const { return editable_; }
    void set_editable(bool value) { editable_ = value; }
    bool is_composing() const { return ime_composing_; }
    std::size_t get_composition_length() const { return 0; }
    std::size_t get_selection_start() const { return selection_start_; }
    std::size_t get_selection_length() const { return selection_length_; }
    void set_selection_start(std::size_t value) { selection_start_ = value; }
    void set_selection_length(int value) { selection_length_ = value; }
    void set_cursor(std::size_t, bool);
    void set_selection(std::size_t, int);
    void handle_key_backspace(SDL_Keymod, bool&);
    void handle_key_delete(SDL_Keymod, bool&);
    void update_canvas() {} void queue_redraw() {} void reset_cursor_state() {}
    template<class... T> void fire(T&&...) { ++modified_events; }
    void commit(const std::string& text) {
        bool handled = false;
        // Same virtual member-function binding as the pinned GUI constructor.
        std::bind(&text_box_base::handle_commit, this, std::ref(handled), text)();
        if(!handled) throw std::runtime_error("commit not handled");
    }
    void preedit(const std::string& text, int start = 0, int length = 1) {
        bool handled = false;
        std::bind(&text_box_base::handle_editing, this, std::ref(handled), text, start, length)();
        if(!handled) throw std::runtime_error("preedit not handled");
    }
    void paste() { paste_selection(); }
    void copy() { copy_selection(); }
    void cut() { copy_selection(); if(is_editable()) delete_selection(); }
    void backspace() { bool handled = false; handle_key_backspace(0, handled); }
    void forward_delete() { bool handled = false; handle_key_delete(0, handled); }
protected:
    virtual void insert_char(const std::string&) = 0;
    virtual void delete_char(bool) = 0;
    virtual void delete_selection() = 0;
    virtual void paste_selection() = 0;
    virtual void copy_selection() = 0;
    virtual void handle_commit(bool&, const std::string&) { throw std::runtime_error("base commit invoked"); }
    virtual void handle_editing(bool&, const std::string&, int32_t, int32_t) {
        throw std::runtime_error("base preedit invoked");
    }
};
class text_box : public text_box_base {
public:
    explicit text_box(const implementation::builder_styled_widget&) {}
    void set_max_input_length(std::size_t) {}
protected:
    void delete_char(bool) override;
};
// @BASE@
}
namespace account = alliance::account;
// @SECRET@
// @EDITOR@
// @PRIVACY@

void check(bool condition, const char* name) {
    if(!condition) throw std::runtime_error(name);
    std::cout << "PASS " << name << '\n';
}
void same(CredentialPasswordBox& box, const std::string& expected, const char* name, bool visible = false) {
    std::string display;
    if(visible) display = expected;
    else for(std::size_t i = 0; i < utf8::size(expected); ++i) display += font::unicode_bullet;
    check(box.get_secret() == expected && box.get_value() == display, name);
}
std::string repeat(const std::string& value, unsigned count) {
    std::string result;
    while(count--) result += value;
    return result;
}
void privacy_checks() {
    {
        CredentialRenderPrivacy guard;
        check(lg::quiet(), "render_domains_suppressed_for_scope");
        check(lg::levels.at("font") == lg::severity::LG_INFO, "unrelated_log_domain_unchanged");
        font::get_text_renderer().set_text("fixture-rendered-dummy", false);
    }
    check(lg::restored() && font::get_text_renderer().value.empty(), "shared_renderer_cleared_before_restore");
    {
        CredentialRenderPrivacy outer;
        { CredentialRenderPrivacy inner; font::get_text_renderer().set_text("fixture-nested", false); }
        check(lg::quiet(), "nested_scope_keeps_outer_suppression");
    }
    check(lg::restored(), "nested_scope_restores_original_levels");
    try {
        CredentialRenderPrivacy guard;
        font::get_text_renderer().set_text("fixture-exception", false);
        throw std::runtime_error("dummy scope failure");
    } catch(const std::runtime_error&) {}
    check(lg::restored() && font::get_text_renderer().value.empty(), "exception_unwind_clears_and_restores");
    bool teardown_guarded = false;
    struct Window {
        bool& guarded;
        explicit Window(bool& result) : guarded(result) {}
        ~Window() { guarded = lg::quiet(); font::get_text_renderer().value = "fixture-final-draw"; }
    };
    struct Dialog : CredentialRenderPrivacy, Window {
        explicit Dialog(bool& result) : Window(result) {}
    };
    { Dialog dialog(teardown_guarded); }
    check(teardown_guarded && lg::restored() && font::get_text_renderer().value.empty(),
          "privacy_first_base_outlives_window_teardown");
    lg::fail_get = "gui/draw";
    bool rejected = false;
    try { CredentialRenderPrivacy guard; } catch(const std::runtime_error&) { rejected = true; }
    lg::fail_get.clear();
    check(rejected && lg::restored(), "unavailable_domain_aborts_and_rolls_back");
    lg::fail_set = "gui/draw"; rejected = false;
    try { CredentialRenderPrivacy guard; } catch(const std::runtime_error&) { rejected = true; }
    lg::fail_set.clear();
    check(rejected && lg::restored(), "failed_suppression_aborts_and_rolls_back");
    {
        CredentialRenderPrivacy guard;
        font::get_text_renderer().value = "fixture-failed-clear";
        font::get_text_renderer().fail_clear = true;
    }
    check(lg::quiet(), "failed_renderer_clear_leaves_logging_suppressed");
    font::get_text_renderer().fail_clear = false;
    font::get_text_renderer().set_text("", false);
    lg::levels["gui/layout"] = lg::severity::LG_DEBUG;
    lg::levels["gui/draw"] = lg::severity::LG_WARN;
    {
        CredentialRenderPrivacy guard;
        lg::fail_restore = "gui/layout";
    }
    lg::fail_restore.clear();
    check(lg::levels.at("gui/layout") == lg::severity::LG_NONE &&
          lg::levels.at("gui/draw") == lg::severity::LG_WARN, "failed_restore_is_noexcept_and_stays_suppressed");
    lg::levels["gui/draw"] = lg::severity::LG_NONE;
    { CredentialRenderPrivacy guard; }
    check(lg::quiet(), "already_disabled_logging_stays_disabled");
    lg::levels["gui/layout"] = lg::severity::LG_DEBUG;
    lg::levels["gui/draw"] = lg::severity::LG_WARN;
}
int main() {
    privacy_checks();
    gui2::implementation::builder_styled_widget builder;
    CredentialPasswordBox box(builder);
    const std::string dummy = "Fixture-aZ_19!@#$%^&*()[]{};:'\"\\/<>? `~";
    for(char c : dummy) box.commit(std::string(1, c));
    same(box, dummy, "hardware_style_ascii_and_symbols_masked");
    box.set_password_visible(true);
    same(box, dummy, "show_same_canonical_value", true);
    box.set_selection(7, -5);
    box.set_password_visible(false);
    check(box.get_selection_start() == 7 && static_cast<int>(box.get_selection_length()) == -5,
          "hide_preserves_backward_selection");
    box.set_password_visible(true);
    check(box.get_selection_start() == 7 && static_cast<int>(box.get_selection_length()) == -5,
          "show_preserves_backward_selection");
    box.set_value("abcDEFghi"); box.set_selection(3, 3); box.commit("XYZ");
    same(box, "abcXYZghi", "forward_middle_replace_visible", true);
    box.set_selection(6, -3); box.commit("Q");
    same(box, "abcQghi", "backward_middle_replace_visible", true);
    box.backspace(); same(box, "abcghi", "backspace_visible", true);
    box.forward_delete(); same(box, "abchi", "delete_visible", true);
    box.set_password_visible(false);
    box.set_selection(0, 5); box.commit("new");
    same(box, "new", "select_all_replace_masked");
    box.set_selection(3, -3); box.backspace();
    same(box, "", "backward_select_all_clear");
    box.backspace(); box.forward_delete(); same(box, "", "delete_empty_noop");
    box.commit(dummy); box.set_cursor(0, false); box.backspace();
    same(box, dummy, "backspace_at_start_noop");
    box.set_cursor(utf8::size(dummy), false); box.forward_delete();
    same(box, dummy, "delete_at_end_noop");
    box.set_value(""); desktop::clipboard::value = dummy; box.paste();
    same(box, dummy, "whole_clipboard_paste");
    box.set_password_visible(true); box.set_selection(0, 7); box.copy();
    check(desktop::clipboard::value == dummy, "copy_visible_does_not_export_selection");
    desktop::clipboard::value = "existing dummy clipboard"; box.cut();
    same(box, dummy.substr(7), "cut_visible_deletes_only", true);
    check(desktop::clipboard::value == "existing dummy clipboard", "cut_keeps_clipboard");
    box.set_value("abc"); box.set_selection(0, 3); desktop::clipboard::value.clear(); box.paste();
    same(box, "abc", "empty_paste_preserves_selection_value", true);
    box.commit(""); same(box, "abc", "empty_commit_preserves_value", true);
    check(box.get_selection_start() == 0 && box.get_selection_length() == 3,
          "empty_commit_preserves_selection");
    box.set_password_visible(false); box.set_value("abcd"); box.set_cursor(1, false);
    box.preedit("x"); same(box, "abcd", "preedit_never_reveals_or_mutates_mask");
    box.preedit("changed", 2, 4); box.preedit("");
    check(box.get_selection_start() == 1 && box.get_selection_length() == 0,
          "preedit_never_moves_cursor");
    box.commit("x"); same(box, "axbcd", "middle_preedit_then_commit_keeps_neighbor");
    box.set_password_visible(true); box.set_selection(4, -2); box.preedit("ignored");
    same(box, "axbcd", "visible_preedit_preserves_value", true);
    box.commit("Z"); same(box, "axZd", "preedit_keeps_replacement_selection", true);
    box.set_password_visible(false);
    const std::string unicode = "\xC3\xA9\xF0\x9F\x94\x92\xE4\xB8\xAD";
    box.set_value(""); box.commit(unicode); same(box, unicode, "utf8_two_three_four_byte_commit");
    box.set_selection(2, -1); box.commit("Q");
    same(box, "\xC3\xA9Q\xE4\xB8\xAD", "utf8_selection_indexes_characters");
    box.set_value(std::string(127, 'a')); box.commit("BC");
    same(box, std::string(127, 'a') + "B", "ascii_limit_has_no_hidden_tail");
    box.commit("ignored"); same(box, std::string(127, 'a') + "B", "full_capacity_commit_noop");
    box.set_selection(0, 128); box.backspace(); same(box, "", "clear_limit_removes_entire_secret");
    const std::string nonbmp = "\xF0\x9F\x94\x92";
    box.set_value(repeat(nonbmp, 127)); box.commit(nonbmp + nonbmp);
    same(box, repeat(nonbmp, 128), "utf8_128_limit_counts_scalars");
    box.set_password_visible(true); same(box, repeat(nonbmp, 128), "show_utf8_at_limit", true);
    box.set_selection(128, -2); box.commit(nonbmp + nonbmp + nonbmp);
    same(box, repeat(nonbmp, 128), "replace_at_limit_clips_before_edit", true);
    check(box.get_selection_start() == 128 && box.get_selection_length() == 0,
          "limited_replacement_cursor_matches_inserted_prefix");
    box.set_value(repeat(nonbmp, 129)); same(box, repeat(nonbmp, 128), "setter_obeys_unicode_limit", true);
    box.set_value(repeat(nonbmp, 127) + "a" + nonbmp);
    same(box, repeat(nonbmp, 127) + "a", "byte_bound_may_cut_discarded_tail_only", true);
    box.set_value("abc"); box.set_selection(1, 1);
    for(const std::string& bad : {std::string("\xFF"), std::string("\xC0\xAF"),
                                std::string("\xED\xA0\x80"), std::string("\xF4\x90\x80\x80"),
                                std::string("\xE2\x82"), std::string("a\0b", 3)}) {
        box.commit(bad);
        if(box.get_secret() != "abc" || box.get_selection_start() != 1 || box.get_selection_length() != 1)
            throw std::runtime_error("malformed input modified canonical value");
    }
    same(box, "abc", "malformed_utf8_and_nul_leave_value_selection_unchanged", true);
    box.set_value(std::string("\xFF")); same(box, "abc", "malformed_setter_noop", true);
    box.set_editable(false); box.commit("new"); desktop::clipboard::value = "new"; box.paste(); box.cut();
    same(box, "abc", "read_only_rejects_all_edits", true);
    box.set_editable(true); box.set_value(""); box.commit("\ntext");
    same(box, "\ntext", "committed_control_prefix_preserved", true);
    box.set_selection(0, 5); desktop::clipboard::value = "\r\n\t exact paste "; box.paste();
    same(box, "\r\n\t exact paste ", "paste_preserves_whitespace_without_normalization", true);
    box.set_value(""); box.set_password_visible(false); same(box, "", "closing_clear_resets_value_and_mask");
    CredentialPasswordBox reopened(builder); reopened.commit(dummy);
    same(reopened, dummy, "new_dialog_always_starts_masked");
    std::string wiped = dummy; clear_secret(wiped); check(wiped.empty(), "live_secret_cleared");
    std::cout << "PASS all credential editor cases\n";
}
