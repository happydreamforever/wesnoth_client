// Actual planning controllers; only modal selection and request boundaries are scripted.
#include "alliance_native/account_client.hpp"
#include "alliance_game/practice_plan.hpp"
#include "alliance_game/hero_catalog.hpp"
#include "alliance_game/team_views.hpp"
#include "alliance_game/replay_launch.hpp"
#include <algorithm>
#include <deque>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

namespace account = alliance::account;
void require(bool condition, const std::string& reason)
{
    if(!condition) throw std::runtime_error(reason);
}
struct Step { std::string title, action, concurrent_change; };
struct Menu { std::string title, text; std::vector<std::string> rows; };
std::deque<Step> steps;
std::vector<Menu> menus;
std::vector<alliance_game::BattleView> views;
std::vector<std::string> messages, requests;
account::Battle server_plan;
int detail_reads = 0, fail_read = 0, empty_read = 0, practice_calls = 0, hero_mutations=0;
bool hero_cancel=false,hero_actor_change=false,bad_hero_ack=false;

namespace alliance_game {
struct Session { std::string token; account::Profile profile; } session;
Session& current_session() { return session; }
void message(const std::string& text) { messages.push_back(text); }
int select(const std::string& title, const std::string& text, const std::vector<std::string>& rows)
{
    require(!steps.empty(), "Unexpected modal: " + title);
    const Step step = steps.front(); steps.pop_front();
    require(step.title == title, "Wrong modal: " + title);
    menus.push_back({title, text, rows});
    if(step.concurrent_change == "leave") {
        server_plan.validity = "roster_changed";
        server_plan.teams[1].players[1].ready = false;
    } else if(step.concurrent_change == "cancel") {
        server_plan.state = "cancelled";
        for(auto& team : server_plan.teams) for(auto& player : team.players) player.ready = false;
    } else require(step.concurrent_change.empty(), "Unknown concurrent change");
    if(step.action == "<close>") return -1;
    const auto item = std::find(rows.begin(), rows.end(), step.action);
    require(item != rows.end(), "Missing action: " + step.action);
    return static_cast<int>(item - rows.begin());
}
std::string battle_unit_image(const std::string& type,bool){return "portrait/"+type;}
std::string battle_map_preview(const std::string& scenario){return "map/"+scenario;}
std::string view_text(const BattleView& view){std::string text=view.subtitle;for(const auto& row:view.rows)text+="\n"+row.title+"\n"+row.subtitle+"\n"+row.detail;return text;}
BattleResult show_battle_view(const BattleView& view) {
    views.push_back(view);
    if(view.actions.empty()){message(view_text(view));return {};}
    std::vector<std::string> actions;
    for(const auto& action:view.actions)actions.push_back(action.label);
    const int selected=select(view.title,view_text(view),actions);
    if(selected>=0)require(view.actions[selected].enabled,"Disabled rich action accepted");
    return {std::max(0,view.selected),selected};
}
bool team_request(const alliance::TrustedProfile&, account::Request input,
                  const std::string&, account::Reply& output)
{
    requests.push_back(input.operation);
    if(input.operation == "battle_detail") {
        require(input.battle_id == server_plan.id, "Requested a different plan");
        ++detail_reads;
        if(detail_reads == fail_read) return false;
        if(detail_reads != empty_read) output.battle = server_plan;
    } else if(input.operation == "my_battles") {
        account::BattleSummary summary;
        summary.id = server_plan.id; summary.state = server_plan.state; summary.created_at = server_plan.created_at;
        for(const auto& team : server_plan.teams) summary.teams.push_back({team.id, team.name});
        output.battles.push_back(summary);
        summary.id = "200599c9-610f-4d81-b8bb-1cb1b79e5f27";
        output.battles.push_back(summary);
    } else if(input.operation=="battle_select_hero") {
        ++hero_mutations;require(input.battle_id==server_plan.id,"Selection plan mismatch");
        const auto& form=hero_forms().front();require(input.hero_id==form.hero_id&&input.form_id==form.id,"Selection identity mismatch");
        for(auto& team:server_plan.teams){team.approved=false;for(auto& player:team.players){
            player.ready=false;if(player.id==session.profile.account_id){player.selection_present=true;player.hero_id=input.hero_id;player.form_id=input.form_id;player.hero_revision=session.profile.heroes.front().revision;}
        }}
        if(bad_hero_ack)server_plan.teams[1].players[0].ready=true;
        output.battle=server_plan;
    } else throw std::runtime_error("Unexpected request: " + input.operation);
    output.ok = true;
    return true;
}
bool battle_mutation(const alliance::TrustedProfile&, account::Request,
                     const std::string&, account::Battle&)
{
    throw std::runtime_error("Viewing planning state must not mutate the server");
}
void practice_plan(const alliance::TrustedProfile&, const account::Battle& battle)
{
    require(battle.state == "draft", "Only an eligible draft may practice");
    ++practice_calls;
}
bool practice_pending() { return practice_calls != 0; }
// Network gameplay/replay boundaries are covered separately; these cases
// exercise the original planning/refresh paths with no retained recording.
bool progression_pending() { return false; }
bool shared_pending() { return false; }
bool replay_pending() noexcept { return false; }
void join_shared_battle(const alliance::TrustedProfile&, const account::Battle&, bool) { throw std::runtime_error("Unexpected gameplay action"); }
void download_shared_replay(const alliance::TrustedProfile&, const account::Battle&) { throw std::runtime_error("Unexpected replay download action"); }
void shared_result_review(const alliance::TrustedProfile&, const account::Battle&) { throw std::runtime_error("Unexpected result action"); }
struct SharedJournalBoundary { std::string run_id, status; };
std::vector<SharedJournalBoundary> inspect_pending_shared(const std::string&) { return {}; }
std::string verified_shared_replay(const std::string&, const std::string&) { throw std::runtime_error("No local recording"); }
void queue_alliance_replay(AllianceReplay, const std::string&, const std::string&) { throw std::runtime_error("Unexpected replay action"); }
bool same_extension_actor(const std::string& id) { return id==session.profile.account_id; }
bool choose_hero(const alliance::TrustedProfile&, std::string& hero,std::string& form) {
    if(hero_cancel)return false;
    hero=hero_forms().front().hero_id;form=hero_forms().front().id;
    if(hero_actor_change)session.profile.account_id="00000000-0000-0000-0000-000000000099";
    return true;
}

// @FUNCTIONS@
}

void reset()
{
    steps.clear(); menus.clear(); views.clear(); messages.clear(); requests.clear();
    detail_reads = fail_read = empty_read = practice_calls = hero_mutations = 0;
    hero_cancel=hero_actor_change=bad_hero_ack=false;
    server_plan = {};
    server_plan.id = "100599c9-610f-4d81-b8bb-1cb1b79e5f27";
    server_plan.state = "draft"; server_plan.validity = "valid";
    server_plan.created_at = "2026-10-22T12:00:00Z";
    server_plan.map = {"isars-cross", "Isar's Cross", "multiplayer_Isars_Cross", 2, {{1,4},{2,3}}};
    server_plan.teams = {{"00000000-0000-0000-0000-000000000020", "Koichi", "00000000-0000-0000-0000-000000000001", true,
        {{"00000000-0000-0000-0000-000000000001", "UniPlayer", "Spearman", 1, 1, true, {}, {}},
         {"00000000-0000-0000-0000-000000000002", "UniRecruit", "Spearman", 1, 4, true, {}, {}}}},
        {"00000000-0000-0000-0000-000000000021", "RivalPlan", "00000000-0000-0000-0000-000000000003", true,
        {{"00000000-0000-0000-0000-000000000003", "UniSolo", "Elvish Fighter", 1, 2, false, {}, {}},
         {"00000000-0000-0000-0000-000000000004", "UniRival", "Spearman", 1, 3, true, {}, {}}}}};
    for(auto& team:server_plan.teams)for(auto& player:team.players){
        const auto& form=alliance_game::hero_forms().front();
        player.hero_id=form.hero_id;player.form_id=form.id;player.unit_type=form.unit_type;player.level=form.native_level;
        player.hero_level=7;player.hero_revision=4;player.selection_present=true;
    }
    alliance_game::session={};alliance_game::session.token="fixture-token";
    alliance_game::session.profile.account_id="00000000-0000-0000-0000-000000000001";
    alliance_game::session.profile.username="UniPlayer";
    account::Hero hero;hero.hero_id=alliance_game::hero_forms().front().hero_id;hero.forms={alliance_game::hero_forms().front().id};hero.revision=4;
    alliance_game::session.profile.heroes={hero};
}
std::string hero_label(const std::string& username){const auto& f=alliance_game::hero_forms().front();return username+" — "+alliance_game::hero_name(f.hero_id)+" / "+f.name+", hero level 7";}
void contains(const std::string& text, const std::string& needle)
{
    require(text.find(needle) != std::string::npos, "Missing text: " + needle);
}
void absent(const std::string& text, const std::string& needle)
{
    require(text.find(needle) == std::string::npos, "Unexpected text: " + needle);
}
bool offered(const Menu& menu, const std::string& action)
{
    return std::find(menu.rows.begin(), menu.rows.end(), action) != menu.rows.end();
}
void check(const std::string& name, void (*run)())
{
    reset(); run();
    require(steps.empty(), "Scripted actions remain after case: " + name);
    std::cout << "PASS " << name << '\n';
}
int main()
{
    try {
        check("refresh replaces both visible lineups after a member leaves", [] {
            steps={{"Battle plan","Refresh plan","leave"},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);
            require(detail_reads==2&&views.size()==2&&messages.empty(),"Rich refresh did not read once per screen");
            contains(menus.back().text,"Team membership changed after this plan was saved.");
            contains(menus.back().text,"UniRival");contains(menus.back().text,"Inactive readiness: Not ready");
            absent(menus.back().text,"The saved lineups match the current teams and leaders.");
        });
        check("refresh shows cancellation and history without active actions", [] {
            steps={{"Battle plan","Refresh plan","cancel"},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);
            require(detail_reads==2&&views.size()==2,"Cancellation was not refreshed");
            contains(menus.back().text,"cancelled and inactive");
            contains(menus.back().text,"Saved readiness: Not ready");
            require(!offered(menus.back(),"Cancel this battle plan")&&!offered(menus.back(),"Set myself not ready"),"Historical mutations available");
        });
        check("failed rich refresh never displays cached lineups or retries", [] {
            fail_read=2;steps={{"Battle plan","Refresh plan","leave"}};
            alliance_game::battle_detail({},server_plan.id);
            require(detail_reads==2&&views.size()==1&&messages.empty()&&practice_calls==0,"Failed refresh fell back to cached state");
        });
        check("missing refresh response never reuses cached rich view", [] {
            empty_read=2;steps={{"Battle plan","Refresh plan","cancel"}};
            alliance_game::battle_detail({},server_plan.id);
            require(detail_reads==2&&views.size()==1,"Missing response reused old lineups");
        });
        check("each explicit refresh reads the newest plan again", [] {
            steps={{"Battle plan","Refresh plan",""},{"Battle plan","Refresh plan","leave"},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);
            require(detail_reads==3&&views.size()==3,"Repeated refresh used cache");
            contains(menus.back().text,"Team membership changed after this plan was saved.");
        });
        check("cancelled valid old readiness is retained and explicitly historical", [] {
            server_plan.state = "cancelled";
            const auto text = alliance_game::battle_text(server_plan);
            contains(text, "The saved lineups match the current teams and leaders.");
            contains(text, "cancelled and inactive");
            contains(text, "Captain approval (inactive): Approved");
            contains(text, hero_label("UniRival") + " — Saved readiness (history): Ready");
            contains(text, hero_label("UniSolo") + " — Saved readiness (history): Not ready");
            absent(text, "hero level 7 — Ready");
            require(server_plan.teams[1].players[1].ready && server_plan.teams[1].approved,
                    "Rendering must not rewrite server history");
            require(!alliance_game::can_practice_plan(server_plan, alliance_game::session.profile), "Cancelled practice must be unavailable");
            contains(text, "Cancelled plans are history only. Local practice is unavailable.");
        });
        check("completed consent is historical and practice is not offered", [] {
            server_plan.state = "completed";
            const auto text = alliance_game::battle_text(server_plan);
            contains(text, "complete and inactive. It cannot start again.");
            contains(text, "Saved readiness (history): Ready");
            contains(text, "Captain approval (inactive): Approved");
            absent(text, "practise this saved lineup");
            steps = {{"Battle plan", "<close>", ""}};
            alliance_game::battle_detail({}, server_plan.id);
            contains(menus[0].text, "complete and inactive");
            require(!offered(menus[0], "Practice this plan") && !offered(menus[0], "Watch completed battle replay"), "Completed plan offers practice or a nonexistent recording");
            require(offered(menus[0], "Review shared battle result"), "Completed result cannot be reviewed");
        });
        check("current captain approval is not invented from historical ready players", [] {
            server_plan.state = "cancelled";
            server_plan.teams[0].captain_id = "00000000-0000-0000-0000-000000000002";
            server_plan.teams[0].approved = false;
            const auto text = alliance_game::battle_text(server_plan);
            contains(text, "Team: Koichi\nTeam ID: 00000000-0000-0000-0000-000000000020\nCaptain approval (inactive): Waiting");
            contains(text, hero_label("UniPlayer") + " — Saved readiness (history): Ready");
            absent(text, "Saved captain approval (history)");
            require(!server_plan.teams[0].approved, "UI changed the protocol approval projection");
        });
        check("every invalid draft labels saved consent inactive without inventing a reset", [] {
            for(const auto* reason : {"roster_changed", "area_changed", "map_unavailable", "leader_changed",
                    "player_unavailable", "team_unavailable", "busy", "rules_changed"}) {
                server_plan.validity = reason;
                const auto text = alliance_game::battle_text(server_plan);
                contains(text, "This draft cannot start a shared battle while these changes remain.");
                contains(text, "Captain approval (inactive): Approved");
                contains(text, hero_label("UniRival") + " — Saved readiness (inactive): Ready");
                absent(text, "hero level 7 — Ready");
                require(server_plan.teams[1].players[1].ready, "Rendering rewrote saved consent");
            }
        });
        check("valid draft displays the server's exact current ready values", [] {
            const auto text = alliance_game::battle_text(server_plan);
            contains(text, "Captain approval: Approved");
            contains(text, hero_label("UniRival") + " — Ready");
            contains(text, hero_label("UniSolo") + " — Not ready");
            absent(text, "inactive");
            absent(text, "(history)");
        });
        check("invalid draft may withdraw saved readiness but never add or approve it", [] {
            server_plan.validity = "roster_changed";
            server_plan.teams[0].approved = false;
            steps = {{"Battle plan", "<close>", ""}};
            alliance_game::battle_detail({}, server_plan.id);
            require(offered(menus[0], "Set myself not ready") && !offered(menus[0], "Set myself ready") &&
                    !offered(menus[0], "Approve this plan"), "Invalid draft consent actions changed");
            contains(menus[0].text, "Captain approval and saved readiness are inactive.");
        });
        check("cancelled plan stays history only without a practice action", [] {
            server_plan.state = "cancelled"; server_plan.validity = "roster_changed";
            steps = {{"Battle plan", "<close>", ""}};
            alliance_game::battle_detail({}, server_plan.id);
            require(practice_calls == 0 && detail_reads == 1 && !offered(menus[0], "Practice this plan"), "Cancelled practice was offered");
            contains(menus[0].text, "cancelled and inactive");
            contains(menus[0].text, "Cancelled plans are history only. Local practice is unavailable.");
        });
        check("identical names and timestamps remain distinguishable by plan IDs", [] {
            steps = {{"My battle plans", "<close>", ""}};
            alliance_game::my_battles({});
            require(views[0].rows.size()==2&&views[0].rows[0].detail!=views[0].rows[1].detail,"Identical plans ambiguous");
            contains(views[0].rows[0].detail,server_plan.id);
            contains(views[0].rows[1].detail,"200599c9-610f-4d81-b8bb-1cb1b79e5f27");
        });
        check("empty side requires owned hero before ready or approval", [] {
            server_plan.teams[0].players[0].selection_present=false;server_plan.teams[0].players[0].ready=false;
            server_plan.teams[0].approved=false;
            steps={{"Battle plan","<close>",""}};alliance_game::battle_detail({},server_plan.id);
            require(offered(menus[0],"Choose my hero"),"Missing hero selection");
            for(const auto* action:{"Set myself ready","Practice this plan","Approve this plan"})require(!offered(menus[0],action),"Unselected hero exposed consent");
            contains(alliance_game::battle_text(server_plan),"Choose a hero before Ready");
        });
        check("both selected lineups allow captain review but no early ready", [] {
            server_plan.teams[0].approved=false;server_plan.teams[0].players[0].ready=false;
            steps={{"Battle plan","<close>",""}};alliance_game::battle_detail({},server_plan.id);
            require(offered(menus[0],"Approve this plan")&&!offered(menus[0],"Set myself ready"),"Approval/ready order broken");
        });
        check("hero chooser cancellation does not mutate", [] {
            hero_cancel=true;steps={{"Battle plan","Change my hero",""},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);require(hero_mutations==0,"Cancelled chooser mutated");
        });
        check("same current hero and form is a no-op", [] {
            steps={{"Battle plan","Change my hero",""},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);require(hero_mutations==0,"Same selection mutated");
            contains(messages.back(),"already selected");
        });
        check("fresh hero revision requires selection confirmation and resets consent", [] {
            ++alliance_game::session.profile.heroes[0].revision;
            steps={{"Battle plan","Change my hero",""},{"Confirm hero selection","Save my hero",""},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);require(hero_mutations==1,"Upgrade selection not saved");
            for(const auto& t:server_plan.teams){require(!t.approved,"Approval retained");for(const auto& p:t.players)require(!p.ready,"Ready retained");}
            require(!offered(menus.back(),"Set myself ready"),"Ready offered before renewed approval");
        });
        check("selection confirmation Back preserves consent", [] {
            ++alliance_game::session.profile.heroes[0].revision;
            steps={{"Battle plan","Change my hero",""},{"Confirm hero selection","<close>",""},{"Battle plan","<close>",""}};
            alliance_game::battle_detail({},server_plan.id);require(hero_mutations==0&&server_plan.teams[0].approved,"Back mutated consent");
        });
        check("actor change while choosing prevents selection mutation", [] {
            hero_actor_change=true;steps={{"Battle plan","Change my hero",""}};
            alliance_game::battle_detail({},server_plan.id);require(hero_mutations==0,"Changed actor mutated selection");
        });
        check("malformed selection acknowledgement retaining ready is rejected", [] {
            ++alliance_game::session.profile.heroes[0].revision;bad_hero_ack=true;
            steps={{"Battle plan","Change my hero",""},{"Confirm hero selection","Save my hero",""}};
            bool rejected=false;try{alliance_game::battle_detail({},server_plan.id);}catch(const std::runtime_error&){rejected=true;}
            require(rejected&&hero_mutations==1,"Invalid acknowledgement accepted or retried");
        });
        std::cout << "PASS all planning refresh and history cases\n";
        return 0;
    } catch(const std::exception& error) {
        std::cerr << "FAIL " << error.what() << '\n';
        return 1;
    }
}
