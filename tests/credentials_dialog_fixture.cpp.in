// Actual dialog + pinned grid::swap_child; GUI drawing/event loop are substitutes.
#include <algorithm>
#include <cassert>
#include <functional>
#include <iostream>
#include <map>
#include <memory>
#include <stdexcept>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

struct config : std::map<std::string, std::string> {};
namespace gui2 {
namespace retval { constexpr int OK = 1, CANCEL = 0; }
namespace implementation {
struct builder_styled_widget { std::string id; };
struct builder_text_box : builder_styled_widget {
    explicit builder_text_box(const config& c) { id = c.at("id"); }
};
}
class widget {
public:
    enum class visibility { visible, hidden, invisible };
    explicit widget(std::string id = "") : id_(std::move(id)) {}
    virtual ~widget() = default;
    const std::string& id() const { return id_; }
    virtual widget* find(std::string_view id, bool) { return id == id_ ? this : nullptr; }
    widget* parent() const { return parent_; }
    void set_parent(widget* value) { parent_ = value; }
    visibility get_visible() const { return visible_; }
    void set_visible(visibility value) { visible_ = value; }
    template<class T> T* find_widget(std::string_view id, bool active, bool required) {
        auto* value = dynamic_cast<T*>(find(id, active));
        if(required && !value) throw std::runtime_error("missing widget");
        return value;
    }
    template<class T> T& find_widget(std::string_view id, bool active = false) {
        return *find_widget<T>(id, active, true);
    }
private:
    std::string id_;
    widget* parent_ = nullptr;
    visibility visible_ = visibility::visible;
};
class grid : public widget {
    struct child {
        std::unique_ptr<widget> value;
        const std::string& id() const { return value->id(); }
        widget* get_widget() const { return value.get(); }
        std::unique_ptr<widget> free_widget() { return std::move(value); }
        void set_widget(std::unique_ptr<widget> next) { value = std::move(next); }
    };
    std::vector<child> children_;
    unsigned rows_, cols_;
public:
    grid(unsigned rows, unsigned cols, std::string id = "")
        : widget(std::move(id)), rows_(rows), cols_(cols) {}
    void add(std::unique_ptr<widget> value) {
        value->set_parent(this);
        children_.push_back({std::move(value)});
    }
    unsigned get_rows() const { return rows_; }
    unsigned get_cols() const { return cols_; }
    widget* get_widget(unsigned row, unsigned col) { return children_.at(row * cols_ + col).get_widget(); }
    widget* find(std::string_view id, bool active) override {
        if(auto* result = widget::find(id, active)) return result;
        for(auto& child : children_) if(auto* result = child.get_widget()->find(id, active)) return result;
        return nullptr;
    }
    std::unique_ptr<widget> swap_child(const std::string&, std::unique_ptr<widget>, bool, widget* = nullptr);
};
// @GRID_SWAP@
template<class... T>
std::unique_ptr<grid> make_grid(unsigned rows, unsigned cols, std::string id, T... children) {
    auto result = std::make_unique<grid>(rows, cols, std::move(id));
    (result->add(std::move(children)), ...);
    return result;
}
class scrollbar_panel : public widget {
public:
    explicit scrollbar_panel(std::unique_ptr<grid> content) : content_(std::move(content)) {
        content_->set_parent(this);
    }
    widget* find(std::string_view id, bool active) override { return content_->find(id, active); }
private:
    std::unique_ptr<grid> content_;
};
class text_box : public widget {
public:
    explicit text_box(std::string id) : widget(std::move(id)) {}
    explicit text_box(const implementation::builder_styled_widget& b) : widget(b.id) {}
    virtual void set_value(const std::string& value) { value_ = value; }
    const std::string& get_value() const { return value_; }
    void set_max_input_length(unsigned value) { maximum_ = value; }
    void set_active(bool value) { active_ = value; }
    unsigned maximum_ = 0;
    bool active_ = true;
private:
    std::string value_;
};
class password_box : public text_box { public: using text_box::text_box; };
class label : public widget {
public:
    label(std::string id, std::string text = "") : widget(std::move(id)), label_(std::move(text)) {}
    void set_use_markup(bool) {}
    void set_label(const std::string& value) { label_ = value; }
    std::string label_;
};
class button : public label { public: using label::label; };
class toggle_button : public label {
public:
    using label::label;
    void set_value(bool value) { value_ = value; }
    bool get_value_bool() const { return value_; }
    void click(bool value) { value_ = value; changed_(); }
    std::function<void()> changed_;
private:
    bool value_ = false;
};
namespace event {
template<class T> void connect_signal_notify_modified(toggle_button& button, T callback) {
    button.changed_ = std::move(callback);
}
}
enum class layout_kind { stock, wrapped, missing_password, invalid_parent };
layout_kind selected_layout = layout_kind::stock;
std::unique_ptr<grid> make_layout();
namespace dialogs {
class modal_dialog : public widget {
public:
    explicit modal_dialog(const std::string& id) : widget(id), grid_(make_layout()) { grid_->set_parent(this); }
    void set_allow_plugin_skip(bool value) { allow_skip_ = value; }
    grid& get_grid() { return *grid_; }
    widget* find(std::string_view id, bool active) override { return grid_->find(id, active); }
    void keyboard_capture(widget* value) { focus_ = value; }
    void add_to_tab_order(widget* value) { tab_order_.push_back(value); }
    int get_retval() const { return result_; }
    void begin() { pre_show(); }
    void finish(int result) { result_ = result; post_show(); }
    bool allow_skip_ = true;
    widget* focus_ = nullptr;
    std::vector<widget*> tab_order_;
protected:
    virtual const std::string& window_id() const = 0;
    virtual void pre_show() = 0;
    virtual void post_show() = 0;
private:
    std::unique_ptr<grid> grid_;
    int result_ = retval::CANCEL;
};
}
}
class CredentialRenderPrivacy {};
class CredentialPasswordBox : public gui2::text_box {
public:
    explicit CredentialPasswordBox(const gui2::implementation::builder_styled_widget& builder)
        : text_box(builder) { ++live; }
    ~CredentialPasswordBox() override { --live; }
    const std::string& get_secret() const { return get_value(); }
    void set_password_visible(bool visible) { visible_ = visible; }
    static int live;
    bool visible_ = false;
};
int CredentialPasswordBox::live = 0;
// @CLEAR_SECRET@
// @DIALOG@
// @LEGACY_DIALOG@

namespace gui2 {
// Generated from the actual matching window_default.cfg and mp_login.cfg.
// @LAYOUT@
std::unique_ptr<grid> make_layout() {
    auto stock = stock_layout();
    if(selected_layout == layout_kind::wrapped) {
        return make_grid(1, 1, "", std::make_unique<scrollbar_panel>(std::move(stock)));
    }
    if(selected_layout == layout_kind::missing_password) {
        auto& original = stock->find_widget<text_box>("password");
        auto* parent = dynamic_cast<grid*>(original.parent());
        parent->swap_child("password", std::make_unique<widget>("unrelated"), false);
    }
    if(selected_layout == layout_kind::invalid_parent) {
        // A malformed theme exposes the field but claims a nongrid owner.
        stock->find_widget<text_box>("password").set_parent(stock->find("remember_password", false));
    }
    return stock;
}
}
void check(bool value, const char* name) {
    if(!value) throw std::runtime_error(name);
    std::cout << "PASS " << name << '\n';
}
void open_and_complete(bool confirm_only, bool accept) {
    std::string username = "FixturePlayer", secret = "old-fixture-value";
    CredentialsDialog dialog(username, secret, "Fixture description", "Fixture action", confirm_only);
    auto* original = dialog.find("password", false);
    auto* parent = original->parent();
    auto* unaffected = dialog.find("user_name", false);
    original->set_visible(gui2::widget::visibility::hidden);
    dialog.begin();
    auto& editor = dialog.find_widget<CredentialPasswordBox>("password");
    auto& name = dialog.find_widget<gui2::text_box>("user_name");
    auto& toggle = dialog.find_widget<gui2::toggle_button>("remember_password");
    check(editor.parent() == parent && static_cast<gui2::widget*>(&editor) != original,
          "editor_installed_in_original_owning_grid");
    check(editor.get_visible() == gui2::widget::visibility::hidden, "original_visibility_preserved");
    check(dialog.find("user_name", false) == unaffected && name.maximum_ == 24,
          "username_widget_preserved_and_bounded");
    check(!dialog.allow_skip_ && editor.get_secret().empty() && !editor.visible_ && !toggle.get_value_bool(),
          "dialog_opens_empty_hidden_without_plugin_skip");
    check(toggle.label_ == "Show password" && toggle.get_visible() == gui2::widget::visibility::visible,
          "show_password_toggle_ready");
    check(dialog.tab_order_.size() == 2 && dialog.tab_order_[1] == &editor,
          "tab_order_references_installed_editor");
    check(name.active_ == !confirm_only && dialog.focus_ == (confirm_only ? static_cast<gui2::widget*>(&editor) : &name),
          "initial_focus_and_confirmation_username_state");
    check(dialog.find_widget<gui2::label>("login_label").label_ == "Fixture description" &&
          dialog.find_widget<gui2::button>("ok").label_ == "Fixture action", "dialog_labels_initialized");
    editor.set_value("dummy-fixture-password");
    toggle.click(true);
    check(editor.visible_ && dialog.focus_ == &editor, "toggle_targets_replacement_and_focus");
    dialog.finish(accept ? gui2::retval::OK : gui2::retval::CANCEL);
    check(secret == (accept ? "dummy-fixture-password" : ""), "submit_or_cancel_handles_canonical_value");
    check(editor.get_secret().empty() && !editor.visible_ && !toggle.get_value_bool() && name.get_value().empty(),
          "closing_clears_all_credential_widgets");
}
int main() {
    for(auto layout : {gui2::layout_kind::stock, gui2::layout_kind::wrapped}) {
        gui2::selected_layout = layout;
        std::string name, secret;
        bool rejected = false;
        {
            LegacyCredentialsDialog dialog(name, secret, "fixture", "fixture");
            auto* original = dialog.find("password", false);
            try { dialog.begin(); } catch(const std::runtime_error&) { rejected = true; }
            check(rejected && dialog.find("password", false) == original && CredentialPasswordBox::live == 0,
                  "legacy_outer_grid_swap_reproduces_open_failure");
        }
        for(bool confirm : {false, true}) for(bool accept : {false, true}) open_and_complete(confirm, accept);
        check(CredentialPasswordBox::live == 0, "replacement_ownership_released_on_close");
    }
    for(auto layout : {gui2::layout_kind::missing_password, gui2::layout_kind::invalid_parent}) {
        gui2::selected_layout = layout;
        std::string name, secret;
        bool rejected = false;
        CredentialsDialog dialog(name, secret, "fixture", "fixture");
        try { dialog.begin(); } catch(const std::runtime_error&) { rejected = true; }
        check(rejected && dialog.tab_order_.empty() && dialog.focus_ == nullptr && CredentialPasswordBox::live == 0,
              "malformed_layout_fails_before_focus_or_submission");
    }
    std::cout << "PASS all credential dialog construction cases\n";
}
