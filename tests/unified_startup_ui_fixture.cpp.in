namespace account=alliance::account;
namespace {
struct Choice{bool accepted;int selected;};
struct Credential{bool accepted;std::string username,password;};
std::deque<Choice> choices;
std::deque<Credential> credentials;
std::deque<account::Reply> replies;
std::vector<std::string> operations,messages,menu_titles;
int login_prompts=0, auth_windows=0, backdrops=0, redraws=0, paints=0, foreground_depth=0;
bool revoke_on_retry=false,cancel_next_request=false,reauth_latched=false;std::vector<std::pair<std::string,std::string>> reauth_requests;int reauth_clears=0;
std::vector<std::string> welcome_notices;
std::vector<bool> signup_visibility;
void need(bool value){if(!value)throw std::runtime_error("assertion");}
void clear_secret(std::string& value){value.clear();}
struct Session{std::string token,identity;account::Profile profile;void clear(){token.clear();identity.clear();profile={};}};
Session session;
Session& current_session(){return session;}
void message(const std::string& value){need(auth_windows==0);messages.push_back(value);}
void show_failure(const account::Reply& value){if(value.error_code=="invalid_session")session.clear();message(value.error_code);}
bool valid_username(const std::string& s){return s.size()>=3&&s.size()<=24;}
struct CredentialsDialog{
 std::string& name;std::string& password;
 CredentialsDialog(std::string& n,std::string& p,const std::string&,const std::string&,bool=false):name(n),password(p){need(auth_windows==0);++auth_windows;++login_prompts;}
 ~CredentialsDialog(){--auth_windows;}
 bool show(){need(!credentials.empty());auto c=credentials.front();credentials.pop_front();name=c.username;password=c.password;return c.accepted;}
};
bool request(const alliance::TrustedProfile&,account::Request& input,const std::string&,account::Reply& output){
 need(auth_windows==0);need(input.starter_id.empty());operations.push_back(input.operation);if(cancel_next_request){cancel_next_request=false;input.password.clear();input.token.clear();return false;}need(!replies.empty());output=replies.front();replies.pop_front();input.password.clear();input.token.clear();return true;
}
void application_decisions(const alliance::TrustedProfile&,bool){need(auth_windows==0);}
}
namespace utf8{std::size_t size(const std::string&s){return s.size();}}
struct rect {int x=0,y=0,w=800,h=600;};
struct color_t {int r,g,b,a;};
namespace video {rect game_canvas(){return {};}}
namespace draw_manager {void invalidate_all(){++redraws;}}
namespace draw {void fill(const rect&,color_t c){need(c.a==255);++paints;}}
namespace gui2 {
struct widget {enum class visibility {visible,hidden,invisible};};
namespace retval {constexpr int CANCEL=-2;}
struct top_level_drawable {
 top_level_drawable(){++backdrops;} virtual ~top_level_drawable(){--backdrops;}
 virtual rect screen_location()=0;virtual bool expose(const rect&)=0;
};
}
namespace gui2::dialogs{
struct message {
 enum button_id {left_1,cancel,ok,right_1,count};
 std::array<std::string,count> labels{};std::array<int,count> values{};
 std::array<gui2::widget::visibility,count> visibility{};int result=gui2::retval::CANCEL;
 message(const std::string& title,const std::string& text,bool,bool,bool){need(auth_windows==0&&backdrops==1);++auth_windows;menu_titles.push_back(title);welcome_notices.push_back(text);}
 ~message(){--auth_windows;}
 void set_allow_plugin_skip(bool value){need(!value);}
 void set_button_caption(button_id i,const std::string& s){labels[i]=s;}
 void set_button_visible(button_id i,gui2::widget::visibility v){visibility[i]=v;}
 void set_button_retval(button_id i,int v){values[i]=v;}
 void set_enter_disabled(bool v){need(v);}
 void show(){need(labels[left_1]=="Log in"&&labels[ok]=="Sign up"&&labels[cancel]=="Quit");need(visibility[left_1]==gui2::widget::visibility::visible&&visibility[cancel]==gui2::widget::visibility::visible);need(!choices.empty());bool allow=visibility[ok]==gui2::widget::visibility::visible;signup_visibility.push_back(allow);auto c=choices.front();choices.pop_front();need(!c.accepted||c.selected!=1||allow);result=c.accepted?values[c.selected==0?left_1:ok]:values[cancel];}
 int get_retval(){return result;}
};
struct simple_item_selector{
 Choice selected{};
 simple_item_selector(const std::string& title,const std::string&,const std::vector<std::string>&){menu_titles.push_back(title);}
 void set_allow_plugin_skip(bool){} void set_cancel_label(const std::string&){}
 bool show(){need(!choices.empty());selected=choices.front();choices.pop_front();return selected.accepted;}
 int selected_index(){return selected.selected;}
};
}
namespace alliance::account{
TrustedProfile read_public_profile(const std::string&){return {"127.0.0.1",15001,"pem","pin"};}
const char* ProfileReadError::what()const noexcept{return "profile failure";}
}
namespace alliance_game {
PlayerSession::~PlayerSession(){clear_secret(token);}
void retry_story_results() noexcept {if(revoke_on_retry){session.clear();revoke_on_retry=false;}}
int select(const std::string& title,const std::string&,const std::vector<std::string>& items){need(title=="Heroes");need(items==std::vector<std::string>({"My heroes","Account details"}));menu_titles.push_back(title);need(!choices.empty());auto c=choices.front();choices.pop_front();return c.accepted?c.selected:-1;}
void heroes_dialog(const alliance::TrustedProfile&){}
void refresh(const alliance::TrustedProfile&){}

const HeroForm* find_hero_form(const std::string& hero,const std::string& form) noexcept {static HeroForm spec{"konrad_fighter","konrad","Fighter","Rebels","Fighter",1,32,{}};return hero=="konrad"&&form=="konrad_fighter"?&spec:nullptr;}
int scaled_hero_stat(int base,std::int64_t,int){return base;} // Gallery/scaling has a separate real-controller fixture.
std::string battle_unit_image(const std::string&,bool){return "portraits/konrad.png";}
BattleResult show_battle_view(const BattleView& view){menu_titles.push_back(view.title);need(!choices.empty());const auto c=choices.front();choices.pop_front();return {c.selected,c.accepted?0:-1};}
struct AccountNetworkActivity {AccountNetworkActivity(){++foreground_depth;}~AccountNetworkActivity(){--foreground_depth;}};
void request_session_reauthentication(const std::string& actor,const std::string& generation){reauth_requests.emplace_back(actor,generation);reauth_latched=true;}
void clear_session_reauthentication() noexcept {++reauth_clears;reauth_latched=false;}
// @FUNCTIONS@
}
namespace {
account::Profile profile(){account::Profile p;p.account_id="11111111-1111-4111-8111-111111111111";p.username="NewPlayer";p.database_generation="22222222-2222-4222-8222-222222222222";return p;}
account::Reply ok(bool token=false){account::Reply r;r.ok=true;r.profile=profile();if(token)r.token=std::string(43,'a');return r;}
account::Reply owned(){auto r=ok();account::Hero h;h.hero_id="konrad";h.name="Konrad";h.hero_level=5;h.revision=4;h.forms={"konrad_fighter"};r.profile.heroes.push_back(h);return r;}
void reset(){need(auth_windows==0&&backdrops==0&&foreground_depth==0);revoke_on_retry=cancel_next_request=reauth_latched=false;reauth_requests.clear();reauth_clears=0;welcome_notices.clear();signup_visibility.clear();redraws=paints=0;session.clear();choices.clear();credentials.clear();replies.clear();operations.clear();messages.clear();menu_titles.clear();login_prompts=0;setenv("WESNOTH_ALLIANCE_PROFILE","/public-profile.json",1);}
void ready(){session.profile=profile();session.token=std::string(43,'a');session.identity="127.0.0.1:15001:pin";}
}
int main(){try{
 reset();choices.push_back({false,0});need(!alliance_game::ensure_player_session());need(operations.empty());
 std::cout<<"PASS startup Back exits without guest access\n";
 reset();choices.push_back({true,0});credentials.push_back({true,"NewPlayer","fixture-password"});replies.push_back(ok(true));need(alliance_game::ensure_player_session());need(operations==std::vector<std::string>{"login"});need(login_prompts==1);
 replies.push_back(ok());need(alliance_game::ensure_player_session());need(login_prompts==1);need(operations.back()=="me");
 std::cout<<"PASS startup login is shared and refresh never asks a second password\n";
 reset();choices.push_back({true,1});credentials.push_back({true,"NewPlayer","fixture-password"});credentials.push_back({true,"NewPlayer","fixture-password"});replies.push_back(ok());replies.push_back(ok(true));need(alliance_game::ensure_player_session());need(session.profile.heroes.empty());need(operations==std::vector<std::string>({"register","login"}));need(menu_titles.size()==1);
 std::cout<<"PASS signup creates an empty collection and automatically signs in without a starter selector\n";
 reset();choices.push_back({true,1});choices.push_back({false,0});credentials.push_back({true,"NewPlayer","fixture-password"});credentials.push_back({true,"NewPlayer","different-password"});need(!alliance_game::ensure_player_session());need(operations.empty());
 std::cout<<"PASS mismatched signup confirmation sends no account mutation\n";
 reset();ready();auto changed=ok();changed.profile.database_generation="33333333-3333-4333-8333-333333333333";replies.push_back(changed);choices.push_back({false,0});need(!alliance_game::ensure_player_session());need(session.token.empty());
 std::cout<<"PASS database reset generation forces a fresh login\n";
 reset();ready();account::Reply unavailable;unavailable.error_code="unavailable";replies.push_back(unavailable);choices={{false,0}};need(!alliance_game::ensure_player_session());need(session.token.empty());need(login_prompts==0);need(signup_visibility==std::vector<bool>{false});need(welcome_notices.back().find("Connection to the Windows server was lost")!=std::string::npos);
 std::cout<<"PASS failed foreground verification signs out and displays restricted authentication before explicit Quit\n";
 reset();ready();replies={unavailable,ok(true)};choices={{true,0}};credentials={{true,"NewPlayer","fixture-password"}};need(alliance_game::ensure_player_session());need(operations==std::vector<std::string>({"me","login"}));need(session.profile.account_id==profile().account_id&&signup_visibility==std::vector<bool>{false});
 std::cout<<"PASS service recovery after foreground failure returns to the same account without exiting\n";
 reset();ready();cancel_next_request=true;replies={ok(true)};choices={{true,0}};credentials={{true,"NewPlayer","fixture-password"}};need(alliance_game::ensure_player_session());need(operations==std::vector<std::string>({"me","login"}));
 std::cout<<"PASS cancelled foreground verification also returns to authentication instead of exiting\n";
 reset();ready();account::Reply expired;expired.error_code="invalid_session";replies.push_back(expired);choices.push_back({false,0});need(!alliance_game::ensure_player_session());need(session.token.empty());
 std::cout<<"PASS revoked session returns to startup authentication\n";
 reset();ready();replies.push_back(ok());choices.push_back({false,0});std::string hero,form;need(!alliance_game::choose_hero(alliance::account::read_public_profile("x"),hero,form));need(hero.empty()&&form.empty());need(menu_titles==std::vector<std::string>{"Your heroes"});
 std::cout<<"PASS empty collection cannot choose or silently receive a starter hero\n";
 reset();ready();replies.push_back(owned());replies.push_back(owned());choices.push_back({true,0});choices.push_back({true,0});need(alliance_game::choose_hero(alliance::account::read_public_profile("x"),hero,form));need(hero=="konrad"&&form=="konrad_fighter");need(operations==std::vector<std::string>({"me","me"}));
 std::cout<<"PASS owned hero choice is bound to a fresh hero revision after both selectors\n";
 reset();ready();replies.push_back(owned());auto advanced=owned();advanced.profile.heroes[0].revision++;replies.push_back(advanced);choices.push_back({true,0});choices.push_back({true,0});hero.clear();form.clear();need(!alliance_game::choose_hero(alliance::account::read_public_profile("x"),hero,form));need(hero.empty()&&form.empty());
 std::cout<<"PASS concurrent hero advancement invalidates an unconfirmed selection\n";
 reset();ready();replies.push_back(owned());choices.push_back({false,0});need(!alliance_game::choose_hero(alliance::account::read_public_profile("x"),hero,form));need(operations==std::vector<std::string>{"me"});
 std::cout<<"PASS selection Back does not mutate server readiness or hero state\n";

 reset();{alliance_game::AuthenticationBackdrop bg;need(backdrops==1);need(bg.expose(bg.screen_location()));need(paints==1);}need(backdrops==0&&redraws==2);
 std::cout<<"PASS opaque full-screen backdrop paints and removes itself cleanly\n";
 reset();choices={{true,0},{false,0}};credentials={{false,"NewPlayer","fixture-password"}};need(!alliance_game::ensure_player_session());need(operations.empty()&&menu_titles.size()==2);
 std::cout<<"PASS cancelled login returns to one clean direct-button welcome\n";
 reset();choices={{true,1},{false,0}};credentials={{false,"NewPlayer","fixture-password"}};need(!alliance_game::ensure_player_session());need(operations.empty()&&menu_titles.size()==2);
 std::cout<<"PASS cancelled signup returns to welcome without a second modal\n";
 reset();choices={{true,1},{false,0}};credentials={{true,"NewPlayer","fixture-password"},{false,"NewPlayer",""}};need(!alliance_game::ensure_player_session());need(operations.empty()&&menu_titles.size()==2);
 std::cout<<"PASS password confirmation opens after signup closes and cancellation clears it\n";
 reset();choices={{true,0},{true,0}};credentials={{true,"NewPlayer","wrong-password"},{true,"NewPlayer","fixture-password"}};account::Reply bad;bad.error_code="invalid_credentials";replies={bad,ok(true)};need(alliance_game::ensure_player_session());need(operations==std::vector<std::string>({"login","login"}));
 std::cout<<"PASS failed login closes before feedback and direct retry\n";
 reset();choices={{true,0}};credentials={{true,"NewPlayer","fixture-password"}};replies={ok(true)};need(alliance_game::ensure_player_session(profile().account_id,profile().database_generation,"Connection lost. Log in again."));need(signup_visibility==std::vector<bool>{false});need(welcome_notices==std::vector<std::string>{"Connection lost. Log in again."});
 std::cout<<"PASS reconnect hides signup and carries its notice on the opaque welcome\n";
 for(bool wrong_generation:{false,true}){
  reset();choices={{true,0},{true,0}};credentials={{true,"OtherPlayer","fixture-password"},{true,"NewPlayer","fixture-password"}};auto other=ok(true);if(wrong_generation)other.profile.database_generation="33333333-3333-4333-8333-333333333333";else other.profile.account_id="33333333-3333-4333-8333-333333333333";replies={other,ok(),ok(true)};need(alliance_game::ensure_player_session(profile().account_id,profile().database_generation,"Reconnect"));need(operations==std::vector<std::string>({"login","logout","login"}));need(session.profile.account_id==profile().account_id&&session.profile.database_generation==profile().database_generation);need(messages.front().find("player who started this game")!=std::string::npos);
 }
 std::cout<<"PASS wrong reconnect actor or database generation is revoked before common-session admission\n";
 reset();ready();session.profile.account_id="33333333-3333-4333-8333-333333333333";replies={ok()};choices={{false,0}};need(!alliance_game::ensure_player_session(profile().account_id,profile().database_generation,"Reconnect"));need(operations==std::vector<std::string>{"logout"}&&session.token.empty());
 std::cout<<"PASS a mismatched existing token cannot bypass the restricted gate\n";
 reset();ready();choices={{false,0}};alliance_game::show_account_dialog();need(menu_titles==std::vector<std::string>{"Heroes"});need(operations.empty());need(!session.token.empty());
 std::cout<<"PASS Heroes contains collection and details only, never logout\n";
 reset();ready();replies={ok()};alliance_game::logout_player();need(session.token.empty()&&session.profile.account_id.empty());need(operations==std::vector<std::string>{"logout"});need(messages.empty());
 reset();ready();replies={bad};alliance_game::logout_player();need(session.token.empty()&&messages.empty());
 std::cout<<"PASS main-menu logout clears common session with or without server acknowledgement\n";
 reset();ready();need(alliance_game::has_player_session());alliance_game::invalidate_player_session();need(!alliance_game::has_player_session());need(session.token.empty()&&session.identity.empty()&&session.profile.account_id.empty());need(operations.empty());
 std::cout<<"PASS network invalidation clears session without network or dialog recursion\n";
 reset();revoke_on_retry=true;choices={{true,0},{false,0}};credentials={{true,"NewPlayer","fixture-password"}};replies={ok(true)};need(!alliance_game::ensure_player_session());need(session.token.empty()&&menu_titles.size()==2);
 std::cout<<"PASS queued-result revocation returns to authentication instead of admitting an empty session\n";
 reset();ready();session.identity="replaced-profile";alliance_game::logout_player();need(session.token.empty()&&!reauth_latched&&operations.empty()&&messages.empty());need(reauth_requests.size()==1&&reauth_clears==2);
 std::cout<<"PASS explicit logout clears reauthentication latched by a replaced profile\n";
 std::cout<<"PASS all unified startup UI cases\n";return 0;
}catch(...){std::cerr<<"FAIL unified startup UI fixture\n";return 1;}}
