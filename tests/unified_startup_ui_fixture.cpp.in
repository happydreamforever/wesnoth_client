#include "alliance_game/account_ui.hpp"
#include "alliance_game/battle_ui.hpp"
#include "alliance_game/hero_catalog.hpp"
#include <algorithm>
#include <array>
#include <cstdlib>
#include <deque>
#include <iostream>
#include <stdexcept>
#include <utility>
