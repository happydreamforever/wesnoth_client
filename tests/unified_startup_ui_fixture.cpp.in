#include "alliance_game/account_ui.hpp"
#include <chrono>
#include <condition_variable>
#include <deque>
#include <functional>
#include <iostream>
#include <mutex>
#include <stdexcept>
#include <thread>
namespace account=alliance::account;
namespace {
void need(bool value,const char* why="assertion"){if(!value)throw std::runtime_error(why);}
void clear_secret(std::string& value){value.clear();}
struct Session{std::string token,identity;account::Profile profile;void clear(){token.clear();identity.clear();profile={};}}session;
Session& current_session(){return session;}
struct Credential{int result;std::string username="Player",password="fixture-password";};
std::deque<Credential> credentials;std::deque<account::Reply> replies;
std::vector<std::string> operations,messages;std::vector<bool> signup_modes,switches;
int dialogs=0,prompts=0,backdrops=0,galleries=0;bool slow_logout=false,retry_revokes=false;
void message(const std::string& s){need(!dialogs,"dialog overlap");messages.push_back(s);}
void show_failure(const account::Reply& r){message(r.error_code);}
bool valid_username(const std::string&s){return s.size()>=3&&s.size()<=24;}
struct CredentialsDialog {
 std::string& user;std::string& password;int result=0;
 CredentialsDialog(std::string& u,std::string& p,const std::string&,bool signup,bool allow):user(u),password(p){need(!dialogs,"stacked auth");++dialogs;++prompts;signup_modes.push_back(signup);switches.push_back(allow);}
 ~CredentialsDialog(){--dialogs;}
 void show(){need(!credentials.empty(),"missing credential response");auto c=credentials.front();credentials.pop_front();user=c.username;password=c.password;result=c.result;}
 int get_retval(){return result;}
};
bool request(const alliance::TrustedProfile&,account::Request& input,const std::string&,account::Reply& output){need(!dialogs,"network while auth modal exists");operations.push_back(input.operation);need(!replies.empty(),"missing response");output=replies.front();replies.pop_front();input.password.clear();return true;}
void request_session_reauthentication(const std::string&,const std::string&){}
void clear_session_reauthentication()noexcept{}
struct AccountNetworkActivity{AccountNetworkActivity(){}~AccountNetworkActivity(){}};
}
namespace utf8{std::size_t size(const std::string&s){return s.size();}}
struct rect{};struct color_t{int r,g,b,a;};
namespace video{rect game_canvas(){return {};}}
namespace draw_manager{void invalidate_all(){}}
namespace image{struct locator{explicit locator(const char*){}};int get_texture(const locator&){return 0;}}
namespace draw{void blit(int,const rect&){}void fill(const rect&,color_t c){need(c.a==255);}}
namespace gui2 {
namespace retval{constexpr int CANCEL=-2,OK=-1;}
struct top_level_drawable{top_level_drawable(){++backdrops;}virtual ~top_level_drawable(){--backdrops;}virtual rect screen_location()=0;virtual bool expose(const rect&)=0;};
}
namespace alliance::account {
TrustedProfile read_public_profile(const std::string&){return {"127.0.0.1",15001,"pem","pin"};}
const char* ProfileReadError::what()const noexcept{return "profile failure";}
Reply perform_request(const TrustedProfile&,const Request& input,const CancellationToken& cancellation){need(input.operation=="logout"&&session.token.empty(),"local authority retained during quit");need(!dialogs,"logout opened modal");operations.push_back(input.operation);if(slow_logout)while(!cancellation.requested())std::this_thread::sleep_for(std::chrono::milliseconds(5));return {};}
}
namespace alliance_game {
PlayerSession::~PlayerSession(){clear_secret(token);}
void retry_story_results()noexcept{if(retry_revokes){session.clear();retry_revokes=false;}}
void heroes_dialog(const alliance::TrustedProfile&){++galleries;}
// @FUNCTIONS@
}
namespace {
account::Profile profile(){account::Profile p;p.account_id="actor";p.database_generation="generation";p.username="Player";return p;}
account::Reply ok(bool token=false){account::Reply r;r.ok=true;r.profile=profile();if(token)r.token="private-fixture-token";return r;}
void reset(){need(!dialogs&&!backdrops);session.clear();credentials.clear();replies.clear();operations.clear();messages.clear();signup_modes.clear();switches.clear();prompts=galleries=0;slow_logout=retry_revokes=false;setenv("WESNOTH_ALLIANCE_PROFILE","fixture-profile",1);}
void ready(){session={"token","127.0.0.1:15001:pin",profile()};}
void passed(const char* name){std::cout<<"PASS "<<name<<'\n';}
}
int main(){try{using namespace alliance_game;using namespace gui2::retval;
 for(int exit:{CANCEL,13}){reset();credentials={{exit}};need(!ensure_player_session());need(prompts==1&&operations.empty());}passed("login-first Escape and X exit without guest access");
 reset();credentials={{OK}};replies={ok(true)};need(ensure_player_session());need(prompts==1&&operations==std::vector<std::string>{"login"}&&messages.empty());replies={ok()};need(ensure_player_session());need(prompts==1);passed("direct login has no success result and existing session refreshes");
 reset();credentials={{11},{OK}};replies={ok(),ok(true)};need(ensure_player_session());need(signup_modes==std::vector<bool>({false,true}));need(operations==std::vector<std::string>({"register","login"})&&messages.empty()&&session.profile.heroes.empty());passed("single signup form automatically signs into empty collection");
 reset();credentials={{11},{12},{CANCEL}};need(!ensure_player_session());need(operations.empty());passed("mismatched confirmation does not register");
 reset();credentials={{11},{11},{CANCEL}};need(!ensure_player_session());need(signup_modes==std::vector<bool>({false,true,false}));passed("signup back returns to one login form");
 reset();credentials={{11},{CANCEL},{OK}};replies={ok(true)};need(ensure_player_session());need(signup_modes==std::vector<bool>({false,true,false})&&operations==std::vector<std::string>{"login"});passed("signup Escape returns to Login without registering or quitting");
 reset();credentials={{11},{13}};need(!ensure_player_session());need(signup_modes==std::vector<bool>({false,true})&&operations.empty());passed("signup outer X quits directly");
 reset();credentials={{OK,"Player","bad"},{OK}};auto bad=ok();bad.ok=false;bad.error_code="invalid_credentials";replies={bad,ok(true)};need(ensure_player_session());need(prompts==2&&operations.size()==2);passed("failed login retries after form destruction");
 reset();ready();auto lost=ok();lost.ok=false;replies={lost,ok(true)};credentials={{OK}};need(ensure_player_session());need(switches==std::vector<bool>{false});passed("lost session requires same-account login");
 for(bool generation:{false,true}){reset();auto wrong=ok(true);if(generation)wrong.profile.database_generation="other";else wrong.profile.account_id="other";replies={wrong,ok(),ok(true)};credentials={{OK},{OK}};need(ensure_player_session("actor","generation","Recovery"));need(operations==std::vector<std::string>({"login","logout","login"}));need(switches==std::vector<bool>({false,false}));}passed("recovery rejects account or database replacement before admission");
 reset();retry_revokes=true;credentials={{OK},{CANCEL}};replies={ok(true)};need(!ensure_player_session());need(session.token.empty());passed("queued result revocation cannot admit stale session");
 reset();ready();show_account_dialog();need(galleries==1&&operations.empty()&&messages.empty());passed("My Heroes directly opens gallery");
 reset();ready();logout_player();need(session.token.empty()&&session.identity.empty()&&operations==std::vector<std::string>{"logout"}&&messages.empty());passed("quit clears local authority before best-effort logout");
 reset();ready();slow_logout=true;auto start=std::chrono::steady_clock::now();logout_player();auto elapsed=std::chrono::steady_clock::now()-start;need(elapsed>=std::chrono::milliseconds(1450)&&elapsed<std::chrono::seconds(3));need(session.token.empty()&&messages.empty());passed("unreachable logout cancellation bounded at 1.5 seconds");
 reset();ready();session.identity="changed";logout_player();need(session.token.empty()&&operations.empty());passed("replaced profile clears locally without remote logout");
 reset();ready();invalidate_player_session();need(!has_player_session()&&operations.empty());passed("invalidation remains local");
 std::cout<<"PASS all unified startup UI cases\n";return 0;
}catch(const std::exception&e){std::cerr<<"FAIL "<<e.what()<<'\n';return 1;}}
