#include "alliance_native/account_client.hpp"
#include "alliance_game/hero_catalog.hpp"
#include "alliance_game/battle_ui.hpp"
#include <algorithm>
#include <functional>
#include <deque>
#include <iostream>
#include <limits>
#include <stdexcept>
namespace account=alliance::account;
namespace {
void need(bool v,const char* why="assertion"){if(!v)throw std::runtime_error(why);}
struct Session{std::string token;account::Profile profile;void clear(){token.clear();profile={};}} session;
Session& current_session(){return session;}
std::deque<account::Reply> replies;std::vector<std::string> operations,messages;std::function<void()> on_show;
alliance_game::HeroGalleryResult choice;std::vector<alliance_game::HeroGalleryEntry> shown;
void message(const std::string& s){messages.push_back(s);}void show_failure(const account::Reply&){message("failed");}
void request_session_reauthentication(const std::string&,const std::string&){}
bool request(const alliance::TrustedProfile&,account::Request& input,const std::string&,account::Reply& output){need(input.operation=="me","Gallery attempted mutation");operations.push_back(input.operation);need(!replies.empty());output=replies.front();replies.pop_front();return true;}
struct NativeText{std::string str()const{return {};};bool empty()const{return true;}};
struct unit_type {struct Ability{NativeText name,description;};int movement()const{return 5;}int alignment()const{return 0;}static std::string alignment_description(int){return "Lawful";}std::vector<Ability> abilities_metadata()const{return {};}};
struct NativeTypes{const unit_type* find(const std::string&)const{return nullptr;}}unit_types;
std::vector<alliance_game::HeroForm> forms={{"fighter","hero","Fighter","Rebels","Fighter",1,50,{{"sword","blade","melee",15,2}}},{"lord","hero","Lord","Rebels","Lord",3,80,{}}};
account::Profile profile(){account::Profile p;p.account_id="actor";p.database_generation="generation";return p;}
account::Hero owned(){account::Hero h;h.hero_id="hero";h.name="Hero";h.hero_level=11;h.experience=310;h.total_experience=2000;h.revision=7;h.forms={"fighter","lord"};return h;}
account::Reply reply(bool own=true){account::Reply r;r.ok=true;r.profile=profile();if(own)r.profile.heroes={owned()};return r;}
void reset(){session={"token",profile()};replies.clear();operations.clear();messages.clear();shown.clear();on_show={};choice={-1,-1};}
}
namespace alliance_game {
struct HeroCampaignSource{std::string id,title;};struct HeroPresentation{std::string id,name,biography,portrait;std::vector<HeroCampaignSource> campaigns;};
const std::vector<HeroPresentation>& hero_presentations(){static const std::vector<HeroPresentation> h={{"hero","Hero","Story biography","portrait.webp",{{"story","The Story"}}},{"locked","Locked hero","Another biography","locked.webp",{{"other","Another Story"}}}};return h;}
HeroGalleryResult show_hero_gallery(const std::vector<HeroGalleryEntry>& entries,bool){shown=entries;if(on_show)on_show();return choice;}
const HeroForm* find_hero_form(const std::string& hero,const std::string& id)noexcept{for(const auto& f:forms)if(f.hero_id==hero&&f.id==id)return &f;return nullptr;}
std::string battle_unit_image(const std::string& id,bool){return id+".webp";}
// @FUNCTIONS@
}
int main(int argc,char**argv){try{need(argc==2);reset();using namespace alliance_game;const std::string mode=argv[1];alliance::TrustedProfile trusted{};std::string hero="unchanged",form="unchanged";
 if(mode=="catalogue") {const auto e=gallery_entries({owned()});need(e.size()==2&&e[0].owned&&!e[1].owned);need(e[0].forms.size()==2&&e[1].forms.empty());need(e[1].biography.find("Another Story")!=std::string::npos);need(e[0].card_progress.find("Lv 11")!=std::string::npos);}
 else if(mode=="campaign") {const auto e=gallery_entries({},"other");need(e.size()==1&&e[0].id=="locked");need(gallery_entries({},"unknown").empty());}
 else if(mode=="stats") {auto c=hero_form_card(owned(),forms[0]);need(c.detail.find("Hit points: 60")!=std::string::npos);need(c.detail.find("17 × 2")!=std::string::npos);need(c.progress_percent==50);}
 else if(mode=="empty") {replies={reply(false)};heroes_dialog(trusted);need(shown.size()==2&&!shown[0].owned&&!shown[1].owned);need(operations.size()==1);}
 else if(mode=="back") {replies={reply()};need(!choose_hero(trusted,hero,form));need(operations.size()==1);}
 else if(mode=="explicit") {replies={reply(),reply()};choice={0,1};need(choose_hero(trusted,hero,form));need(hero=="hero"&&form=="lord"&&operations.size()==2);}
 else if(mode=="locked") {replies={reply()};choice={1,0};need(!choose_hero(trusted,hero,form));need(operations.size()==1);}
 else if(mode=="invalid") {for(const auto c:std::vector<HeroGalleryResult>{{9,0},{0,9},{0,-1}}){reset();replies={reply()};choice=c;need(!choose_hero(trusted,hero,form));need(operations.size()==1);}}
 else if(mode=="initial_failure") {auto r=reply();r.ok=false;replies={r};need(!choose_hero(trusted,hero,form));need(shown.empty());}
 else if(mode=="final_failure") {auto r=reply();r.ok=false;replies={reply(),r};choice={0,0};need(!choose_hero(trusted,hero,form));need(operations.size()==2);}
 else if(mode=="modal_race") {for(int n=0;n<4;++n){reset();replies={reply()};choice={0,0};on_show=[n]{if(n==0)session.token="changed";else if(n==1)session.profile.account_id="changed";else if(n==2)session.profile.database_generation="changed";else session.clear();};need(!choose_hero(trusted,hero,form));need(operations.size()==1);}}
 else if(mode=="identity_race") {for(bool generation:{false,true}){reset();auto r=reply();if(generation)r.profile.database_generation="changed";else r.profile.account_id="changed";replies={reply(),r};choice={0,0};need(!choose_hero(trusted,hero,form));need(session.token.empty());}}
 else if(mode=="revision_race"||mode=="form_race"||mode=="hero_race") {auto r=reply();if(mode=="revision_race")++r.profile.heroes[0].revision;else if(mode=="form_race")r.profile.heroes[0].forms={"lord"};else r.profile.heroes.clear();replies={reply(),r};choice={0,0};need(!choose_hero(trusted,hero,form));need(operations.size()==2);}
 else throw std::runtime_error("unknown case");
 if(mode!="explicit"){need(hero=="unchanged"&&form=="unchanged");}
 std::cout<<"PASS hero gallery "<<mode<<'\n';return 0;
}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
