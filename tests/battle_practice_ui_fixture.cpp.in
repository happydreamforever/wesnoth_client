void apply_change(Change change)
{
    switch(change) {
    case Change::none: break;
    case Change::cancelled: saved.state = "cancelled"; break;
    case Change::running: saved.state = "running"; break;
    case Change::completed: saved.state = "completed"; break;
    case Change::not_ready: saved.teams[0].players[1].ready = false; break;
    case Change::other_not_ready: saved.teams[1].players[1].ready = false; break;
    case Change::approval: saved.teams[1].approved = false; break;
    case Change::roster: saved.validity = "roster_changed"; break;
    case Change::leader: saved.teams[1].players[1].unit_type = "Swordsman"; saved.teams[1].players[1].level = 2; break;
    case Change::name: saved.teams[1].name = "Changed Team"; break;
    case Change::actor: alliance_game::current_session().profile.account_id = "00000000-0000-0000-0000-000000000099"; break;
    case Change::logout: alliance_game::current_session().token.clear(); break;
    }
}

struct TitleFixture {
    int retval = 0;
    void set_retval(int value)
    {
        require(modal_depth == 0, "The engine handoff must wait for every modal to unwind");
        retval = value;
    }
    void open()
    {
// @TITLE_CALLBACK@
    }
};

void reset()
{
    require(modal_depth == 0, "A previous test leaked a modal");
    events.clear(); seen.clear(); messages.clear(); calls.clear();
    pending = queue_fails = network_fails = identity_changes = false;
    confirmation_change = menu_change = read_change = Change::none;
    mutations = 0; mutation_result = MutationResult::ok;
    detail_reads = change_on_read = fail_call = empty_detail = wrong_detail = 0;
    queue_count = 0; queued = {}; queued_profile = {}; queued_settings = {};
    saved = {};
    saved.id = "00000000-0000-0000-0000-000000000100"; saved.area_id = "area"; saved.state = "draft";
    saved.created_at = "2026-10-22T12:00:00Z"; saved.validity = "valid";
    saved.map = {"isars-cross", "Isar's Cross", "multiplayer_Isars_Cross", 2, {{1,4},{2,3}}};
    saved.teams = {{"00000000-0000-0000-0000-000000000020", "Koichi", "00000000-0000-0000-0000-000000000001", true,
                   {{"00000000-0000-0000-0000-000000000001", "UniPlayer", "Spearman", 1, 1, true},
                    {"00000000-0000-0000-0000-000000000002", "UniRecruit", "Spearman", 1, 4, true}}},
                  {"00000000-0000-0000-0000-000000000021", "RivalPlan", "00000000-0000-0000-0000-000000000003", true,
                   {{"00000000-0000-0000-0000-000000000003", "UniSolo", "Spearman", 1, 2, true},
                    {"00000000-0000-0000-0000-000000000004", "UniRival", "Spearman", 1, 3, true}}}};
    response_profile = {"00000000-0000-0000-0000-000000000002", "UniRecruit", "Spearman", "spearman", 1, 0, 0};
    alliance_game::current_session() = {"dummy-session-secret", response_profile, "127.0.0.1:15001:public-pin"};
    setenv("WESNOTH_ALLIANCE_PROFILE", "/unused/public-profile.json", 1);
}

void check(const std::string& name, void (*run)())
{
    reset(); run();
    require(modal_depth == 0, "Modal lifetime leak");
    std::cout << "PASS " << name << '\n';
}

void all_not_ready()
{
    for(auto& team : saved.teams) for(auto& player : team.players) player.ready = false;
}

bool has_message(const std::string& text)
{
    return std::any_of(messages.begin(), messages.end(), [&](const auto& item) {
        return item.find(text) != std::string::npos;
    });
}

void ready_events()
{
    events = {{"Battle plan", "Set myself ready"},
              {"Confirm ready", "Set myself ready"}};
}

void settings_events(const std::string& mode, int gold, int turns, bool fog)
{
    events.push_back({"Practice setup", "Control mode"});
    events.push_back({"Practice control", mode});
    events.push_back({"Practice setup", "Starting gold"});
    events.push_back({"Practice starting gold", std::to_string(gold) + " gold per side"});
    events.push_back({"Practice setup", "Turn limit"});
    events.push_back({"Practice turn limit", turns == -1 ? "Unlimited" : std::to_string(turns) + " turns"});
    events.push_back({"Practice setup", "Fog"});
    events.push_back({"Practice fog", fog ? "Fog on" : "Fog off"});
}

void default_settings(const alliance_game::PracticeSettings& value)
{
    require(value.control == alliance_game::PracticeControl::own_side && value.starting_gold == 100 &&
            value.turn_limit == -1 && value.fog, "Default settings changed");
}

int main()
{
    try {
        check("selected ready member sees practice and full consent counts", [] {
            require(alliance_game::can_practice_plan(saved, response_profile), "Fully consented draft rejected");
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Practice this plan") != seen[0].rows.end(), "Missing practice");
            for(const auto* part : {"Captains approved: 2/2", "Team readiness: 4/4 selected players Ready"})
                require(seen[0].description.find(part) != std::string::npos, "Missing readiness count");
            require(!pending && queue_count == 0, "Closing must not queue");
        });
        check("missing approval or readiness hides practice and explains who is waiting", [] {
            saved.teams[1].approved = false;
            saved.teams[1].players[1].ready = false;
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Practice this plan") == seen[0].rows.end(), "Unready practice visible");
            for(const auto* part : {"Captains approved: 1/2", "Team readiness: 3/4 selected players Ready",
                                   "Waiting for captain approval: RivalPlan", "Not ready for a shared battle: UniRival"})
                require(seen[0].description.find(part) != std::string::npos, "Missing waiting explanation");
            saved.teams[1].approved = true;
            require(alliance_game::can_practice_plan(saved, response_profile), "Another Not ready player blocked personal practice");
            saved.teams[0].players[1].ready = false;
            require(!alliance_game::can_practice_plan(saved, response_profile), "Own Not ready was accepted");
        });
        check("personal Ready permits practice while every other player is Not ready", [] {
            all_not_ready(); saved.teams[0].players[1].ready = true;
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(alliance_game::can_practice_plan(saved, response_profile), "Own readiness was not sufficient");
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Practice this plan") != seen[0].rows.end(), "Missing personal practice");
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Ready and practice") == seen[0].rows.end(), "Already Ready offered redundant mutation");
            for(const auto* part : {"Your personal practice is available", "Other players do not need to be Ready",
                                   "Team readiness: 1/4 selected players Ready", "future shared battle requires everyone Ready"})
                require(seen[0].description.find(part) != std::string::npos, "Personal/team readiness explanation lost");
            require(mutations == 0 && !pending, "Read-only preview changed Ready or launched");
        });
        check("Not ready selected member sees only the separate readiness control", [] {
            all_not_ready();
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Set myself ready") != seen[0].rows.end(), "Missing readiness choice");
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Practice this plan") == seen[0].rows.end(), "Not ready can directly practice");
            require(seen[0].description.find("Choose Set myself ready first, then choose Practice this plan") != std::string::npos,
                    "Separate action order not explained");
            require(mutations == 0 && !pending, "Read-only menu saved Ready");
        });
        for(const auto* cancel : {"<default>", "<close>", "Back without changes"}) {
            reset(); all_not_ready(); ready_events(); events.back().action = cancel;
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 0 && !pending && !saved.teams[0].players[1].ready, "Ready confirmation Back changed state");
            require(calls == std::vector<std::string>({"battle_detail"}), "Back queried or mutated after refusal");
            require(seen.back().rows.front() == "Back without changes", "Ready consent did not default to Back");
        }
        std::cout << "PASS three separate Ready Back and close cases\n";
        check("Ready alone refreshes the Practice action without launching or changing other consent", [] {
            all_not_ready(); ready_events(); events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && queue_count == 0, "Ready alone launched or retried");
            require(calls == std::vector<std::string>({"battle_detail", "battle_ready", "battle_detail"}),
                    "Ready action skipped refresh or entered practice flow");
            require(seen.size() == 3 && seen.back().title == "Battle plan", "Ready did not return to plan actions");
            require(std::find(seen.back().rows.begin(), seen.back().rows.end(), "Practice this plan") != seen.back().rows.end(),
                    "Confirmed Ready did not expose separate Practice action");
            require(std::find(seen.back().rows.begin(), seen.back().rows.end(), "Set myself not ready") != seen.back().rows.end(),
                    "Ready cannot be withdrawn");
            for(const auto& team : saved.teams) for(const auto& player : team.players)
                require(player.ready == (player.id == response_profile.account_id), "Ready changed another player's consent");
            require(has_message("You are now ready. This does not start a battle."), "Ready did not acknowledge its limited action");
        });
        for(const auto result : {MutationResult::rejected, MutationResult::unknown, MutationResult::wrong_actor}) {
            reset(); all_not_ready(); ready_events(); mutation_result = result;
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && calls.size() == 2, "Unconfirmed Ready retried or entered launch flow");
            require(!has_message("You are now ready"), "Unconfirmed mutation claimed success");
            require(!messages.empty(), "Unconfirmed Ready gave no feedback");
            if(result != MutationResult::rejected)
                require(has_message("may have reached the server"), "Uncertain mutation did not explain possible save");
        }
        std::cout << "PASS three unconfirmed Ready outcomes never start practice\n";
        check("confirmed Ready survives a failed refresh without retry or launch", [] {
            all_not_ready(); ready_events(); fail_call = 3;
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && queue_count == 0 && saved.teams[0].players[1].ready,
                    "Failed refresh undid or retried Ready or started practice");
            require(calls == std::vector<std::string>({"battle_detail", "battle_ready", "battle_detail"}), "Unexpected recovery request");
            require(has_message("The change was confirmed, but the latest plan could not be loaded"), "Confirmed Ready result lost on refresh failure");
        });
        for(const auto change : {Change::cancelled, Change::not_ready, Change::approval, Change::roster}) {
            reset(); all_not_ready(); ready_events(); events.push_back({"Battle plan", "<close>"});
            change_on_read = 2; read_change = change;
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && queue_count == 0, "Ready launched after eligibility changed");
            require(seen.size() == 3 && std::find(seen.back().rows.begin(), seen.back().rows.end(), "Practice this plan") == seen.back().rows.end(),
                    "Refreshed menu ignored changed eligibility");
        }
        std::cout << "PASS four changes after Ready hide Practice on fresh menu\n";
        check("separate Practice confirmation Back preserves Ready without launching", [] {
            all_not_ready(); ready_events();
            events.push_back({"Battle plan", "Practice this plan"});
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "<default>"});
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && queue_count == 0 && saved.teams[0].players[1].ready,
                    "Practice Back changed Ready or launched");
            require(calls == std::vector<std::string>({"battle_detail", "battle_ready", "battle_detail", "me", "battle_detail", "battle_detail"}),
                    "Separate Practice Back retried or performed final launch read");
        });
        check("withdrawing own Ready refreshes away Practice and leaves other consent unchanged", [] {
            all_not_ready(); saved.teams[0].players[1].ready = true;
            events = {{"Battle plan", "Set myself not ready"}, {"Confirm not ready", "Set myself not ready"},
                      {"Battle plan", "<close>"}};
            alliance_game::battle_detail({}, saved.id);
            require(mutations == 1 && !pending && !saved.teams[0].players[1].ready, "Readiness withdrawal failed or launched");
            require(std::find(seen.back().rows.begin(), seen.back().rows.end(), "Practice this plan") == seen.back().rows.end(),
                    "Withdrawn readiness still offered Practice");
            require(std::find(seen.back().rows.begin(), seen.back().rows.end(), "Set myself ready") != seen.back().rows.end(),
                    "Withdrawn readiness lost separate Ready control");
            for(const auto& team : saved.teams) for(const auto& player : team.players)
                require(!player.ready, "Withdrawal changed another player's consent");
            require(has_message("You are now not ready."), "Missing withdrawal acknowledgement");
        });
        check("closed states cannot practice and unavailable recordings never expose replay", [] {
            for(const auto* state : {"cancelled", "running", "completed"}) {
                saved.state = state;
                require(!alliance_game::can_practice_plan(saved, response_profile), "Inactive state accepted");
                events.push_back({"Battle plan", "<close>"});
                alliance_game::battle_detail({}, saved.id);
                const auto& menu = seen.back();
                require(std::find(menu.rows.begin(), menu.rows.end(), "Practice this plan") == menu.rows.end(), "Closed state exposes practice");
                require(std::find(menu.rows.begin(), menu.rows.end(), "Watch completed battle replay") == menu.rows.end(), "Missing recording exposes replay");
                require(std::find(menu.rows.begin(), menu.rows.end(), "Set myself ready") == menu.rows.end(), "Closed state exposes readiness mutation");
                require(menu.description.find("Practice this plan opens") == std::string::npos, "Closed state promises practice");
                if(saved.state == "running") require(std::find(menu.rows.begin(), menu.rows.end(), "Reconnect to my side") != menu.rows.end(), "Running saved side cannot reconnect");
            }
            require(!pending && queue_count == 0, "Closed state launched");
        });
        check("invalid draft outsiders empty and duplicate identities never launch", [] {
            saved.validity = "roster_changed";
            require(!alliance_game::can_practice_plan(saved, response_profile), "Invalid draft accepted");
            alliance_game::practice_plan({}, saved);
            saved.validity = "valid";
            response_profile.account_id = "00000000-0000-0000-0000-000000000099";
            require(!alliance_game::can_practice_plan(saved, response_profile), "Outsider accepted");
            response_profile.account_id.clear();
            require(!alliance_game::can_practice_plan(saved, response_profile), "Empty actor accepted");
            response_profile.account_id = "00000000-0000-0000-0000-000000000002";
            saved.teams[1].players[0].id = response_profile.account_id;
            require(!alliance_game::can_practice_plan(saved, response_profile), "Duplicate actor accepted");
            require(calls.empty() && !pending, "Invalid plan queried or launched");
        });
        check("a captain outside the lineup can approve but cannot practice", [] {
            saved.teams[0].captain_id = "00000000-0000-0000-0000-000000000099";
            saved.teams[0].approved = false;
            alliance_game::current_session().profile.account_id = saved.teams[0].captain_id;
            events.push_back({"Battle plan", "<close>"});
            alliance_game::battle_detail({}, saved.id);
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Approve this plan") != seen[0].rows.end(), "Current captain lost approval");
            require(std::find(seen[0].rows.begin(), seen[0].rows.end(), "Practice this plan") == seen[0].rows.end(), "Unselected captain can practice");
        });
        for(const auto* back : {"<default>", "<close>", "Back without changes"}) {
            reset(); events.push_back({"Practice setup", back});
            alliance_game::practice_plan({}, saved);
            require(events.empty() && !pending && queue_count == 0 && mutations == 0, "Setup cancellation launched or mutated");
            require(calls == std::vector<std::string>({"me", "battle_detail"}), "Setup cancellation made extra requests");
            require(seen.size() == 1 && seen.front().rows.front() == "Back without changes", "Setup default is not Back");
        }
        std::cout << "PASS three setup Back and close paths are read-only\n";
        for(const auto control : {alliance_game::PracticeControl::own_side, alliance_game::PracticeControl::own_team,
                                  alliance_game::PracticeControl::hotseat}) {
            for(int gold : {75, 100, 150, 200}) for(int turns : {20, 30, 50, -1}) for(bool fog : {false, true}) {
                reset(); all_not_ready(); saved.teams[0].players[1].ready = true;
                const std::string mode = alliance_game::practice_control_name(control);
                settings_events(mode, gold, turns, fog);
                events.push_back({"Practice setup", "Review and start"});
                events.push_back({"Confirm local team practice", "Start local practice"});
                alliance_game::practice_plan({}, saved);
                require(events.empty() && pending && queue_count == 1 && mutations == 0, "Configured practice failed or changed server state");
                require(queued_settings.control == control && queued_settings.starting_gold == gold &&
                        queued_settings.turn_limit == turns && queued_settings.fog == fog, "Confirmed settings differ from queued settings");
                const std::string text = seen.back().description;
                for(const auto& expected : {"Control: " + mode, "Starting gold: " + std::to_string(gold) + " per side",
                    "Turn limit: " + (turns == -1 ? std::string("Unlimited") : std::to_string(turns)),
                    std::string("Fog: ") + (fog ? "On" : "Off")})
                    require(text.find(expected) != std::string::npos, "Review did not show exact settings");
                for(const auto& team : saved.teams) for(const auto& player : team.players) {
                    const bool local = control == alliance_game::PracticeControl::hotseat ||
                        (control == alliance_game::PracticeControl::own_team ? team.name == "Koichi" : player.side == 4);
                    const std::string expected = "Side " + std::to_string(player.side) + ": " + player.username +
                        " — Spearman, level 1 — " + team.name + " — " + (local ? "Local player on this device" : "Computer");
                    require(text.find(expected) != std::string::npos, "Review showed wrong local/AI ownership");
                }
                require(text.find("local copies of the saved leaders") != std::string::npos &&
                        text.find("Other players do not join this game") != std::string::npos,
                        "Training scope or turn-limit consequence missing");
                require((text.find("stock Defeat screen") != std::string::npos) == (turns != -1),
                        "Turn-limit consequence does not match the selected duration");
                require(calls == std::vector<std::string>({"me", "battle_detail", "battle_detail"}),
                        "Editing local settings sent mutations or additional requests");
            }
        }
        std::cout << "PASS 96 control gold turn-limit and fog combinations preserve consent and exact review\n";
        check("reset settings restores only local defaults before explicit review", [] {
            settings_events("Local hotseat", 200, 20, false);
            events.push_back({"Practice setup", "Reset to defaults"});
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(events.empty() && pending && queue_count == 1 && mutations == 0, "Reset launched or mutated unexpectedly");
            default_settings(queued_settings);
            require(seen.back().description.find("Control: My side") != std::string::npos, "Reset did not refresh review");
            require(calls == std::vector<std::string>({"me", "battle_detail", "battle_detail"}), "Reset sent a network request");
        });
        for(const auto* back : {"<default>", "<close>", "Back without changes"}) {
            reset(); settings_events("Command my team", 150, 30, false);
            for(const auto& menu : std::vector<std::pair<std::string, std::string>>{
                    {"Control mode", "Practice control"}, {"Starting gold", "Practice starting gold"},
                    {"Turn limit", "Practice turn limit"}, {"Fog", "Practice fog"}}) {
                events.push_back({"Practice setup", menu.first}); events.push_back({menu.second, back});
            }
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(events.empty() && pending && queue_count == 1 && mutations == 0, "Submenu Back launched early or mutated");
            require(queued_settings.control == alliance_game::PracticeControl::own_team && queued_settings.starting_gold == 150 &&
                    queued_settings.turn_limit == 30 && !queued_settings.fog, "Submenu Back changed a chosen setting");
        }
        std::cout << "PASS twelve settings submenu Back and close paths preserve current choices\n";
        check("abandoned setup choices are not reused by a later launch", [] {
            settings_events("Local hotseat", 75, 50, false);
            events.push_back({"Practice setup", "Back without changes"});
            alliance_game::practice_plan({}, saved);
            require(!pending && queue_count == 0 && mutations == 0, "Abandoning setup started practice");
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(events.empty() && pending && queue_count == 1, "Fresh setup did not launch once");
            default_settings(queued_settings);
        });
        for(const auto* mode : {"My side", "Command my team", "Local hotseat"}) {
            for(const auto change : {Change::cancelled, Change::not_ready, Change::approval, Change::roster,
                                    Change::leader, Change::actor, Change::logout}) {
                reset(); confirmation_change = change;
                settings_events(mode, 200, 30, false);
                events.push_back({"Practice setup", "Review and start"});
                events.push_back({"Confirm local team practice", "Start local practice"});
                alliance_game::practice_plan({}, saved);
                require(events.empty() && !pending && queue_count == 0 && mutations == 0 && detail_reads == 2,
                        "Configured practice bypassed snapshot or actor checks");
                require(messages.size() == 1, "Rejected configured launch lacks bounded feedback");
            }
        }
        std::cout << "PASS 21 configured mode consent and actor races reject stale launches\n";
        check("confirmation Open defaults to Back without final read or queue", [] {
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "<default>"});
            alliance_game::practice_plan({}, saved);
            require(!pending && queue_count == 0, "Default must not launch");
            require(seen[0].rows.front() == "Back without changes", "Default row changed");
            require(calls == std::vector<std::string>({"me", "battle_detail"}), "Unexpected consent cancellation request");
        });
        check("confirmation Escape and Back never queue", [] {
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "<close>"});
            alliance_game::practice_plan({}, saved);
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Back without changes"});
            alliance_game::practice_plan({}, saved);
            require(!pending && queue_count == 0 && detail_reads == 2, "Back queued or checked after refusal");
        });
        check("fresh profile actor mismatch and concurrent session change prevent confirmation", [] {
            response_profile.account_id = "00000000-0000-0000-0000-000000000099";
            alliance_game::practice_plan({}, saved);
            require(!pending && seen.empty() && messages.size() == 1, "Response actor mismatch accepted");
            response_profile.account_id = "00000000-0000-0000-0000-000000000002"; identity_changes = true;
            alliance_game::practice_plan({}, saved);
            require(!pending && seen.empty() && messages.size() == 2, "Changed session actor accepted");
        });
        check("network failure and expired local session prevent confirmation", [] {
            network_fails = true;
            alliance_game::practice_plan({}, saved);
            require(seen.empty() && !pending, "Failed me read opened launch");
            network_fails = false; calls.clear(); alliance_game::current_session().token.clear();
            alliance_game::practice_plan({}, saved);
            require(calls.empty() && seen.empty() && !pending, "Empty session queried or launched");
        });
        for(const auto change : {Change::cancelled, Change::running, Change::completed, Change::not_ready, Change::approval, Change::roster}) {
            reset();
            change_on_read = 1; read_change = change;
            const auto cached = saved;
            alliance_game::practice_plan({}, cached);
            require(!pending && seen.empty() && detail_reads == 1, "Pre-confirmation stale state was used");
        }
        std::cout << "PASS six pre-confirmation state and consent races\n";
        for(const auto change : {Change::cancelled, Change::running, Change::completed, Change::not_ready,
                                Change::approval, Change::roster, Change::leader, Change::name, Change::actor, Change::logout}) {
            reset(); confirmation_change = change;
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            const auto cached = saved;
            alliance_game::practice_plan({}, cached);
            require(!pending && queue_count == 0 && detail_reads == 2 && messages.size() == 1,
                    "Confirmation race launched stale or substituted game");
        }
        std::cout << "PASS ten post-confirmation state consent snapshot and actor races\n";
        check("another player's readiness change during confirmation preserves personal launch", [] {
            confirmation_change = Change::other_not_ready;
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(pending && queue_count == 1 && !queued.teams[1].players[1].ready,
                    "Another player's readiness invalidated practice or stale data was queued");
            require(queued.teams[0].players[1].ready && mutations == 0 && messages.empty(),
                    "Personal launch changed consent or reported an error");
        });
        for(int read : {1, 2}) {
            for(int failure : {0, 1, 2}) {
                reset();
                if(failure == 0) fail_call = read + 1;
                if(failure == 1) empty_detail = read;
                if(failure == 2) wrong_detail = read;
                if(read == 2) {
                    events.push_back({"Practice setup", "Review and start"});
                    events.push_back({"Confirm local team practice", "Start local practice"});
                }
                alliance_game::practice_plan({}, saved);
                require(!pending && queue_count == 0 && calls.size() == static_cast<std::size_t>(read + 1),
                        "Failed or wrong-ID read fell back or retried");
                require(seen.size() == static_cast<std::size_t>(2 * (read - 1)), "Failure opened unexpected confirmation");
            }
        }
        std::cout << "PASS six pre/post-confirmation failed missing and wrong-ID reads\n";
        check("change while the action menu is open blocks practice before confirmation", [] {
            menu_change = Change::not_ready;
            events = {{"Battle plan", "Practice this plan"}, {"Battle plan", "<close>"}};
            alliance_game::battle_detail({}, saved.id);
            require(!pending && seen.size() == 2 && messages.size() == 1, "Cached action menu bypassed new readiness");
        });
        check("queue validation failure displays fixed safe feedback", [] {
            queue_fails = true;
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(!pending && queue_count == 0 && messages.size() == 1, "Queue failure not handled");
            require(messages[0].find("private diagnostic") == std::string::npos, "Exception text leaked");
        });
        check("successful launch uses fresh eligible snapshot and makes only three reads", [] {
            response_profile.experience = 5; response_profile.total_experience = 47;
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, saved);
            require(pending && queue_count == 1 && queued_profile.experience == 5 &&
                    alliance_game::same_practice_snapshot(queued, saved, response_profile.account_id), "Fresh consented data was not queued");
            const auto& text = seen.back().description;
            for(const auto* required : {"Control: My side", "Side 4: UniRecruit — Spearman, level 1 — Koichi — Local player on this device", "saved leaders and alliances",
                                       "No players or teams are reserved", "no account experience, team experience or rating",
                                       "Other players do not join this game", "checked again after you confirm"})
                require(text.find(required) != std::string::npos, std::string("Missing explanation: ") + required);
            require(calls == std::vector<std::string>({"me", "battle_detail", "battle_detail"}), "Unexpected launch mutation or retry");
        });
        check("confirmation displays the latest eligible lineup rather than the old menu copy", [] {
            change_on_read = 1; read_change = Change::leader;
            const auto cached = saved;
            events.push_back({"Practice setup", "Review and start"});
            events.push_back({"Confirm local team practice", "Start local practice"});
            alliance_game::practice_plan({}, cached);
            require(pending && queued.teams[1].players[1].unit_type == "Swordsman", "New confirmed lineup was lost");
            require(seen.back().description.find("UniRival — Swordsman, level 2") != std::string::npos,
                    "Confirmation silently used old lineup");
        });
        check("complete title account teams plans detail chain unwinds before handoff", [] {
            events = {{"Alliance", "Teams"}, {"Alliance teams", "Battle plans"},
                      {"Battle plans", "My battle plans"}, {"My battle plans", "", 0},
                      {"Battle plan", "Practice this plan"}, {"Practice setup", "Review and start"}, {"Confirm local team practice", "Start local practice"}};
            TitleFixture title; title.open();
            require(events.empty() && pending && queue_count == 1, "Practice not queued exactly once");
            require(title.retval == alliance_game::practice_title_result, "Title did not request engine handoff");
            require(calls == std::vector<std::string>({"my_battles", "battle_detail", "me", "battle_detail", "battle_detail"}), "Unexpected extra request after queue");
            require(messages.empty(), "An ancestor reopened or failed while unwinding");
            alliance_game::show_account_dialog();
            require(queue_count == 1 && events.empty(), "Pending request permitted a second account flow");
        });
        check("separate Ready then Practice choices unwind the complete title flow", [] {
            all_not_ready();
            events = {{"Alliance", "Teams"}, {"Alliance teams", "Battle plans"},
                      {"Battle plans", "My battle plans"}, {"My battle plans", "", 0},
                      {"Battle plan", "Set myself ready"}, {"Confirm ready", "Set myself ready"},
                      {"Battle plan", "Practice this plan"}, {"Practice setup", "Review and start"}, {"Confirm local team practice", "Start local practice"}};
            TitleFixture title; title.open();
            require(events.empty() && pending && queue_count == 1 && mutations == 1, "Separate choices did not save and queue once");
            require(title.retval == alliance_game::practice_title_result && modal_depth == 0, "Separate choices failed title handoff");
            require(calls == std::vector<std::string>({"my_battles", "battle_detail", "battle_ready", "battle_detail", "me", "battle_detail", "battle_detail"}),
                    "Separate Ready/Practice retried or skipped freshness reads");
            for(const auto& team : queued.teams) for(const auto& player : team.players)
                require(player.ready == (player.id == response_profile.account_id), "Separate Ready changed another player's consent");
            require(messages.size() == 1 && has_message("You are now ready. This does not start a battle."),
                    "Separate Ready lacked acknowledgement or Practice reported unexpected failure");
            alliance_game::show_account_dialog();
            require(queue_count == 1 && mutations == 1 && events.empty(), "Pending launch allowed another action");
        });
        check("cancelled confirmation returns to menus without title handoff", [] {
            events = {{"Alliance", "Teams"}, {"Alliance teams", "Battle plans"},
                      {"Battle plans", "My battle plans"}, {"My battle plans", "", 0},
                      {"Battle plan", "Practice this plan"}, {"Practice setup", "Review and start"}, {"Confirm local team practice", "<default>"},
                      {"Battle plan", "<close>"}, {"My battle plans", "<close>"}, {"Battle plans", "<close>"},
                      {"Alliance teams", "<close>"}, {"Alliance", "<close>"}};
            TitleFixture title; title.open();
            require(events.empty() && !pending && queue_count == 0 && title.retval == 0, "Cancel changed title mode");
            require(messages.empty(), "Cancel flow failed");
        });
        std::cout << "PASS all practice UI cases\n";
        return 0;
    } catch(const std::exception& error) {
        std::cerr << "FAIL " << error.what() << '\n';
        return 1;
    }
}
