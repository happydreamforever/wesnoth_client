# Create .env with .\dev.ps1 configure, then edit this computer's paths and server IP.
# .env stays private. Only the public profile is bundled into the signed APK.
WESNOTH_ENV_FORMAT=1
WESNOTH_PROJECT=client
WESNOTH_SERVER_IP=192.168.1.10
WESNOTH_SERVER_ROOT=../wesnoth_server

# Relative paths are relative to this project. References expand as data, never code.
WESNOTH_PYTHON_PATH=%LOCALAPPDATA%/Programs/Python/Python312/python.exe
WESNOTH_MSYS_ROOT=../msys64
WESNOTH_CMAKE_PATH=%ProgramFiles%/CMake/bin/cmake.exe
WESNOTH_NINJA_PATH=${WESNOTH_MSYS_ROOT}/ucrt64/bin/ninja.exe
WESNOTH_OPENSSL_PATH=${WESNOTH_MSYS_ROOT}/mingw64/bin/openssl.exe
WESNOTH_SDK_ROOT=%LOCALAPPDATA%/Android/Sdk
WESNOTH_JAVA_HOME=%ProgramFiles%/Android/Android Studio/jbr
WESNOTH_GRADLE_USER_HOME=%USERPROFILE%/.gradle
WESNOTH_GAME_DATA_ROOT=../gamedata-1.19.26
WESNOTH_ARCHIVE_DIRECTORY=packaging/android/download
WESNOTH_JOBS=2

# Privately copy the ORIGINAL WINDOWS signer and a signed base APK from the old PC.
# ANDROID_USER_HOME is the directory directly containing debug.keystore.
# Never substitute the different VPS test signer or silently generate a new key.
WESNOTH_ANDROID_USER_HOME=%USERPROFILE%/.android
WESNOTH_SIGNER_REFERENCE_APK=private-originals/windows-base.apk

# Match the server's selected identity directory. Public endpoint/certificate only.
WESNOTH_PUBLIC_PROFILE_PATH=${WESNOTH_SERVER_ROOT}/runtime/alliance-transport/public-profile.json
WESNOTH_ADB_PATH=${WESNOTH_SDK_ROOT}/platform-tools/adb.exe
WESNOTH_ADB_SERIAL=127.0.0.1:5555
